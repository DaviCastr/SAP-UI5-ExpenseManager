<mvc:View
    controllerName="apps.dflc.expensemanager.controller.Login"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
>
    <Page id="loginPage" showHeader="false" backgroundDesign="List" class="loginPage">
        <content>
            <HBox
                id="loginShell"
                class="loginShell"
                height="100%"
                alignItems="Stretch"
                wrap="NoWrap"
            >
                <VBox
                    class="loginHero"
                    alignItems="Start"
                    justifyContent="Center"
                >
                    <HBox alignItems="Center" class="loginHeroBrand sapUiMediumMarginBottom">
                        <core:Icon
                            src="sap-icon://wallet"
                            size="1.9rem"
                            class="loginHeroIcon sapUiSmallMarginEnd"
                        />
                        <Title
                            text="{i18n>brandTitle}"
                            level="H2"
                            titleStyle="H2"
                            class="loginHeroTitle"
                        />
                    </HBox>

                    <Title
                        text="{i18n>loginHeadline}"
                        level="H1"
                        titleStyle="H1"
                        wrap="true"
                        class="loginHeroHeadline sapUiTinyMarginBottom"
                    />

                    <Text
                        text="{i18n>loginSubtitle}"
                        class="loginHeroSubtitle sapUiMediumMarginBottom"
                    />

                    <VBox class="loginFeatures">
                        <HBox alignItems="Center" class="loginFeatureItem">
                            <core:Icon
                                src="sap-icon://credit-card"
                                class="loginFeatureIcon sapUiSmallMarginEnd"
                            />
                            <Text text="{i18n>loginFeatureCards}" class="loginFeatureText" />
                        </HBox>

                        <HBox alignItems="Center" class="loginFeatureItem sapUiTinyMarginTop">
                            <core:Icon
                                src="sap-icon://information"
                                class="loginFeatureIcon sapUiSmallMarginEnd"
                            />
                            <Text text="{i18n>loginFeatureGoals}" class="loginFeatureText" />
                        </HBox>

                        <HBox alignItems="Center" class="loginFeatureItem sapUiTinyMarginTop">
                            <core:Icon
                                src="sap-icon://money-bills"
                                class="loginFeatureIcon sapUiSmallMarginEnd"
                            />
                            <Text text="{i18n>loginFeatureDebts}" class="loginFeatureText" />
                        </HBox>
                    </VBox>
                </VBox>

                <FlexBox
                    class="loginAside"
                    height="100%"
                    justifyContent="Center"
                    alignItems="Center"
                >
                    <VBox
                        id="loginCard"
                        class="loginCard"
                        alignItems="Center"
                    >
                        <HBox alignItems="Center" class="loginBrand sapUiMediumMarginBottom">
                            <core:Icon
                                src="sap-icon://wallet"
                                size="2rem"
                                class="loginBrandIcon sapUiSmallMarginEnd"
                            />
                            <Title
                                text="{i18n>brandTitle}"
                                level="H2"
                                titleStyle="H2"
                                class="loginBrandTitle"
                            />
                        </HBox>

                        <Title
                            text="{i18n>loginHeadline}"
                            level="H1"
                            titleStyle="H3"
                            textAlign="Center"
                            class="loginHeadline sapUiTinyMarginBottom"
                        />

                        <Text
                            text="{i18n>loginSubtitle}"
                            textAlign="Center"
                            class="loginSubtitle sapUiLargeMarginBottom"
                        />

                        <Button
                            id="loginButton"
                            text="{i18n>loginButton}"
                            icon="sap-icon://log"
                            press=".onLogin"
                            type="Emphasized"
                            width="100%"
                            class="loginPrimary sapUiMediumMarginBottom"
                        />

                        <Text
                            text="{i18n>loginNote}"
                            textAlign="Center"
                            class="loginNote sapUiTinyMarginBottom"
                        />
                    </VBox>
                </FlexBox>
            </HBox>
        </content>
    </Page>
</mvc:View>
