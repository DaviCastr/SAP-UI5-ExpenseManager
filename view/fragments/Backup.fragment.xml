<core:FragmentDefinition
    xmlns:core="sap.ui.core"
    xmlns="sap.m"
    xmlns:u="sap.ui.unified"
    id="Backup"
>
    <Dialog
        id="backupDialog"
        title="{i18n>backupDialogTitle}"
        class="financeDialog"
        contentWidth="30rem"
        stretch="{device>/system/stretchDialogs}"
        beforeOpen="handler.onDialogBeforeOpen"
        busy="{ui>/busy}"
        core:require="{
            handler: 'apps/dflc/expensemanager/controller/fragments/Backup'
        }"
    >
        <content>
            <VBox class="sapUiSmallMargin">
                <MessageStrip
                    text="{i18n>backupDialogIntro}"
                    type="Information"
                    showIcon="true"
                    class="sapUiSmallMarginBottom"
                />
                <VBox>
                    <Label
                        text="{i18n>backupFileLabel}"
                        labelFor="backupFileUploader"
                        class="sapUiTinyMarginBottom"
                    />
                    <u:FileUploader
                        id="backupFileUploader"
                        buttonText="{i18n>backupFileButton}"
                        placeholder="{i18n>backupFilePlaceholder}"
                        fileType="zip"
                        change="handler.onBackupFileChanged"
                        width="100%"
                    />
                </VBox>
            </VBox>
        </content>
        <buttons>
            <!-- <beginButton> -->
            <Button
                text="{i18n>backupRestoreButton}"
                icon="sap-icon://download"
                type="Emphasized"
                press="handler.onImportBackup"
            />
            <!-- </beginButton> -->
            <!-- <endButton> -->
            <Button
                text="{i18n>actionExportBackup}"
                icon="sap-icon://download"
                type="Ghost"
                press="handler.onExportBackup"
            />
            <Button
                text="{i18n>backupCancelButton}"
                icon="sap-icon://decline"
                type="Transparent"
                press="handler.onCancelBackup"
            />
            <!-- </endButton> -->
        </buttons>
    </Dialog>
</core:FragmentDefinition>