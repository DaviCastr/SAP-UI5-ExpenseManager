<core:FragmentDefinition
    xmlns:core="sap.ui.core"
    xmlns="sap.m"
    xmlns:u="sap.ui.unified"
    xmlns:layout="sap.ui.layout"
    id="Cards"
    core:require="{
        formatter: 'apps/dflc/expensemanager/util/format',
        handler: 'apps/dflc/expensemanager/controller/fragments/Cards'
    }"
>
    <Dialog
        id="cardsDialog"
        title="{i18n>cardsDialogTitle}"
        class="financeDialog"
        contentWidth="46rem"
        stretch="{device>/system/phone}"
        beforeOpen="handler.onDialogBeforeOpen"
        afterOpen="handler.onDialogAfterOpen"
        afterClose="handler.onDialogAfterClose"
        busy="{ui>/busy}"
    >
        <content>
            <VBox class="sapUiSmallMargin dialogContent">
                <MessageStrip
                    text="{i18n>cardsDialogIntro}"
                    type="Information"
                    showIcon="true"
                    class="sapUiSmallMarginBottom"
                />

                <VBox class="cardManagerAddRow sapUiSmallMarginBottom">
                    <Label
                        text="{i18n>cardsAddLabel}"
                        labelFor="newCardName"
                        class="cardManagerAddTitle"
                    />
                    <HBox wrap="Wrap" alignItems="End" class="sapUiTinyMarginTop">
                        <VBox class="sapUiTinyMarginEnd sapUiTinyMarginBottom">
                            <Label text="{i18n>cardNameLabel}" labelFor="newCardName" />
                            <Input
                                id="newCardName"
                                value="{ui>/newCard/name}"
                                placeholder="{i18n>cardNamePlaceholder}"
                                width="100%"
                            >
                                <layoutData>
                                    <FlexItemData minWidth="12rem" maxWidth="15rem" growFactor="1" />
                                </layoutData>
                            </Input>
                        </VBox>
                        <VBox class="sapUiTinyMarginEnd sapUiTinyMarginBottom">
                            <Label text="{i18n>cardLimitLabel}" labelFor="newCardLimit" />
                            <Input
                                id="newCardLimit"
                                value="{ui>/newCard/limit}"
                                type="Number"
                                placeholder="{i18n>cardLimitPlaceholder}"
                                width="100%"
                            >
                                <layoutData>
                                    <FlexItemData minWidth="6rem" maxWidth="7.5rem" />
                                </layoutData>
                            </Input>
                        </VBox>
                        <VBox class="sapUiTinyMarginEnd sapUiTinyMarginBottom">
                            <Label text="{i18n>cardCurrencyLabel}" labelFor="newCardCurrency" />
                            <Select
                                id="newCardCurrency"
                                selectedKey="{ui>/newCard/currency}"
                                width="100%"
                            >
                                <layoutData>
                                    <FlexItemData minWidth="10rem" maxWidth="12rem" />
                                </layoutData>
                                <core:Item key="BRL" text="Real brasileiro (BRL)" />
                                <core:Item key="USD" text="Dólar americano (USD)" />
                            </Select>
                        </VBox>
                        <VBox class="sapUiTinyMarginEnd sapUiTinyMarginBottom">
                            <Label text="{i18n>cardsClosingLabel}" labelFor="newCardClosing" />
                            <Input
                                id="newCardClosing"
                                value="{ui>/newCard/closingDay}"
                                type="Number"
                                placeholder="{i18n>cardsDayPlaceholder}"
                                width="100%"
                            >
                                <layoutData>
                                    <FlexItemData minWidth="4.5rem" maxWidth="5.5rem" />
                                </layoutData>
                            </Input>
                        </VBox>
                        <VBox class="sapUiTinyMarginEnd sapUiTinyMarginBottom">
                            <Label text="{i18n>cardsDueLabel}" labelFor="newCardDue" />
                            <Input
                                id="newCardDue"
                                value="{ui>/newCard/dueDay}"
                                type="Number"
                                placeholder="{i18n>cardsDayPlaceholder}"
                                width="100%"
                            >
                                <layoutData>
                                    <FlexItemData minWidth="4.5rem" maxWidth="5.5rem" />
                                </layoutData>
                            </Input>
                        </VBox>
                        <Button
                            text="{i18n>cardsAddLabel}"
                            icon="sap-icon://add"
                            type="Emphasized"
                            press="handler.onAddCard"
                            class="sapUiTinyMarginBottom"
                        />
                    </HBox>
                </VBox>

                <List
                    id="cardsList"
                    items="{Cards}"
                    mode="None"
                    growing="true"
                    noDataText="{i18n>cardsNoData}"
                    class="shareList cardManagerList"
                >
                    <CustomListItem class="cardManagerCard sapUiTinyMarginBottom">
                        <VBox class="cardManagerBody">
                            <HBox
                                alignItems="Center"
                                class="cardManagerRow"
                            >
                                <Avatar
                                    src="{ parts: [ { path: 'ID' }, { path: 'ui>/dialogCardImages' } ], formatter: 'formatter.cardImageValue' }"
                                    displaySize="Custom"
                                    customDisplaySize="2.75rem"
                                    displayShape="Circle"
                                    initials="{ parts: [ { path: 'Name' } ], formatter: 'formatter.initials' }"
                                    class="cardManagerAvatar"
                                />
                                <Input
                                    value="{Name}"
                                    placeholder="{i18n>cardNamePlaceholder}"
                                    class="cardManagerInput"
                                >
                                    <layoutData>
                                        <FlexItemData growFactor="1" minWidth="8rem" />
                                    </layoutData>
                                </Input>
                                <u:FileUploader
                                    buttonOnly="true"
                                    iconOnly="true"
                                    icon="sap-icon://camera"
                                    buttonType="Transparent"
                                    tooltip="{i18n>cardsPhotoButton}"
                                    fileType="png,jpg,jpeg"
                                    uploadOnChange="false"
                                    multiple="false"
                                    sendXHR="true"
                                    httpRequestMethod="PUT"
                                    useMultipart="false"
                                    change="handler.onCardPhotoChanged"
                                    class="cardManagerPhoto"
                                />
                                <Button
                                    icon="sap-icon://delete"
                                    type="Transparent"
                                    tooltip="{i18n>cardsRemoveTooltip}"
                                    press="handler.onRemoveCard"
                                />
                            </HBox>
                            <HBox
                                wrap="Wrap"
                                alignItems="End"
                                class="cardManagerFields"
                            >
                                <VBox class="sapUiTinyMarginEnd sapUiTinyMarginBottom">
                                    <Label text="{i18n>cardLimitLabel}" />
                                    <Input
                                        value="{Limit}"
                                        type="Number"
                                        width="100%"
                                    >
                                        <layoutData>
                                            <FlexItemData minWidth="6rem" maxWidth="7.5rem" />
                                        </layoutData>
                                    </Input>
                                </VBox>
                                <VBox class="sapUiTinyMarginEnd sapUiTinyMarginBottom">
                                    <Label text="{i18n>cardCurrencyLabel}" />
                                    <Select
                                        selectedKey="{Currency_code}"
                                        forceSelection="false"
                                        width="100%"
                                    >
                                        <layoutData>
                                            <FlexItemData minWidth="10rem" maxWidth="12rem" />
                                        </layoutData>
                                        <core:Item key="BRL" text="Real brasileiro (BRL)" />
                                        <core:Item key="USD" text="Dólar americano (USD)" />
                                    </Select>
                                </VBox>
                                <VBox class="sapUiTinyMarginEnd sapUiTinyMarginBottom">
                                    <Label text="{i18n>cardsClosingLabel}" />
                                    <Input
                                        value="{ClosingDay}"
                                        type="Number"
                                        width="100%"
                                    >
                                        <layoutData>
                                            <FlexItemData minWidth="4.5rem" maxWidth="5.5rem" />
                                        </layoutData>
                                    </Input>
                                </VBox>
                                <VBox class="sapUiTinyMarginEnd sapUiTinyMarginBottom">
                                    <Label text="{i18n>cardsDueLabel}" />
                                    <Input
                                        value="{DueDay}"
                                        type="Number"
                                        width="100%"
                                    >
                                        <layoutData>
                                            <FlexItemData minWidth="4.5rem" maxWidth="5.5rem" />
                                        </layoutData>
                                    </Input>
                                </VBox>
                            </HBox>
                        </VBox>
                    </CustomListItem>
                </List>
            </VBox>
        </content>
        <buttons>
            <Button
                text="{i18n>cardsSaveButton}"
                icon="sap-icon://save"
                type="Emphasized"
                press="handler.onSaveCards"
            />
            <Button
                text="{i18n>cardsCancelButton}"
                icon="sap-icon://cancel"
                press="handler.onCancelCards"
            />
            <Button
                text="{i18n>cardsDiscardButton}"
                type="Transparent"
                press="handler.onDiscardCards"
            />
        </buttons>
    </Dialog>
</core:FragmentDefinition>