<core:FragmentDefinition
    xmlns:core="sap.ui.core"
    xmlns="sap.m"
    xmlns:u="sap.ui.unified"
    id="Categories"
    core:require="{
        formatter: 'apps/dflc/expensemanager/util/format',
        handler: 'apps/dflc/expensemanager/controller/fragments/Categories'
    }"
>
    <Dialog
        id="categoriesDialog"
        title="{i18n>categoriesDialogTitle}"
        class="financeDialog"
        contentWidth="36rem"
        stretch="{device>/system/phone}"
        beforeOpen="handler.onDialogBeforeOpen"
        afterOpen="handler.onDialogAfterOpen"
        afterClose="handler.onDialogAfterClose"
        busy="{ui>/busy}"
    >
        <content>
            <VBox class="sapUiSmallMargin">
                <MessageStrip
                    text="{i18n>categoriesDialogIntro}"
                    type="Information"
                    showIcon="true"
                    class="sapUiSmallMarginBottom"
                />

                <HBox
                    wrap="Wrap"
                    alignItems="End"
                    class="sapUiSmallMarginBottom"
                    justifyContent="SpaceBetween"
                >
                    <Title text="{i18n>categoriesAddLabel}" level="H5" class="sapUiTinyMarginEnd sapUiTinyMarginBottom" />
                    <HBox wrap="Wrap" alignItems="End">
                        <VBox class="sapUiTinyMarginEnd sapUiTinyMarginBottom">
                            <Label text="{i18n>categoryNameLabel}" labelFor="newCategoryName" />
                            <Input
                                id="newCategoryName"
                                value="{ui>/newCategory/name}"
                                placeholder="{i18n>categoryNamePlaceholder}"
                                maxLength="20"
                                width="16rem"
                            />
                        </VBox>
                        <Button
                            text="{i18n>categoriesAddLabel}"
                            icon="sap-icon://add"
                            type="Emphasized"
                            press="handler.onAddCategory"
                        />
                    </HBox>
                </HBox>

                <List
                    id="categoriesList"
                    items="{Categories}"
                    mode="None"
                    noDataText="{i18n>categoriesNoData}"
                    class="shareList"
                >
                    <CustomListItem class="sapUiTinyMarginBottom">
                        <VBox class="sapUiTinyMarginTopBottom">
                            <HBox
                                alignItems="Center"
                                justifyContent="SpaceBetween"
                                class="sapUiSmallMarginBottom"
                            >
                                <Avatar
                                    src="{ parts: [ { path: 'ID' }, { path: 'ui>/dialogCategoryImages' } ], formatter: 'formatter.cardImageValue' }"
                                    displaySize="Custom"
                                    customDisplaySize="3rem"
                                    displayShape="Circle"
                                    initials="{ parts: [ { path: 'Name' } ], formatter: 'formatter.initials' }"
                                    class="sapUiTinyMarginEnd"
                                />
                                <Input
                                    value="{Name}"
                                    placeholder="{i18n>categoryNamePlaceholder}"
                                    maxLength="20"
                                    width="60%"
                                />
                                <ToolbarSpacer />
                                <Button
                                    icon="sap-icon://delete"
                                    type="Transparent"
                                    tooltip="{i18n>categoriesRemoveTooltip}"
                                    press="handler.onRemoveCategory"
                                />
                            </HBox>
                            <HBox alignItems="Center">
                                <u:FileUploader
                                    buttonText="{i18n>categoriesPhotoButton}"
                                    placeholder="{i18n>categoriesPhotoPlaceholder}"
                                    fileType="png,jpg,jpeg"
                                    uploadOnChange="false"
                                    multiple="false"
                                    change="handler.onCategoryPhotoChanged"
                                    width="100%"
                                />
                            </HBox>
                        </VBox>
                    </CustomListItem>
                </List>
            </VBox>
        </content>
        <buttons>
            <Button
                text="{i18n>categoriesSaveButton}"
                icon="sap-icon://save"
                type="Emphasized"
                press="handler.onSaveCategories"
            />
            <Button
                text="{i18n>categoriesCancelButton}"
                icon="sap-icon://cancel"
                press="handler.onCancelCategories"
            />
            <Button
                text="{i18n>categoriesDiscardButton}"
                type="Transparent"
                press="handler.onDiscardCategories"
            />
        </buttons>
    </Dialog>
</core:FragmentDefinition>