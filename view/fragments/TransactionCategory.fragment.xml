<core:FragmentDefinition
    xmlns:core="sap.ui.core"
    xmlns="sap.m"
    id="TransactionCategory"
    core:require="{
        formatter: 'apps/dflc/expensemanager/util/format',
        handler: 'apps/dflc/expensemanager/controller/fragments/TransactionCategory'
    }"
>
    <Dialog
        id="transactionCategoryDialog"
        title="{i18n>transactionCategoryTitle}"
        class="financeDialog"
        contentWidth="38rem"
        stretch="{device>/system/phone}"
        beforeOpen="handler.onDialogBeforeOpen"
        afterOpen="handler.onDialogAfterOpen"
        afterClose="handler.onDialogAfterClose"
        busy="{ui>/busy}"
    >
        <content>
            <VBox class="sapUiSmallMargin">
                <MessageStrip
                    text="{i18n>transactionCategoryIntro}"
                    type="Information"
                    showIcon="true"
                    class="sapUiSmallMarginBottom"
                />

                <HBox
                    alignItems="Center"
                    class="sapUiTinyMarginTopBottom"
                >
                    <Avatar
                        src="{ parts: [ { path: 'ui>/transactionCategory/currentCategoryId' }, { path: 'ui>/transactionCategory/categoryImages' } ], formatter: 'formatter.cardImageValue' }"
                        initials="{ parts: [ { path: 'ui>/transactionCategory/currentCategoryName' } ], formatter: 'formatter.initials' }"
                        displayShape="Circle"
                        class="invoiceCategoryAvatar sapUiTinyMarginEnd"
                    />
                    <Text
                        text="{ parts: [ { path: 'i18n>transactionCategoryCurrent' }, { path: 'ui>/transactionCategory/currentCategoryName' } ], formatter: 'formatter.formatTemplate' }"
                        class="invoiceAffectedText"
                    />
                </HBox>

                <Text
                    id="categoryAffectedText"
                    text="{ui>/transactionCategory/affectedText}"
                    class="invoiceAffectedCount"
                />

                <List
                    id="transactionCategoryAffectedList"
                    items="{
                        path: '/Transactions',
                        sorter: { path: 'Installment', descending: false },
                        parameters: {
                            $expand: 'Invoice($select=ID,Card_ID,Year,Month;$expand=Card($select=ID)),Category,Currency',
                            $select: 'ID,Identifier,Date,Description,Installment,TotalInstallments',
                            $filter: '(IsActiveEntity eq false or SiblingEntity/IsActiveEntity eq null)'
                        }
                    }"
                    showSeparators="None"
                    class="invoiceAffectedList"
                    noDataText="{i18n>invoiceTransactionsNoData}"
                >
                    <CustomListItem>
                        <HBox
                            width="100%"
                            alignItems="Center"
                            justifyContent="SpaceBetween"
                        >
                            <VBox>
                                <Text text="{Description}" class="transactionTitle" />
                                <Text
                                    text="{ parts: [ { path: 'Installment' }, { path: 'TotalInstallments' }, { path: 'Invoice/Year' }, { path: 'Invoice/Month' } ], formatter: 'formatter.installmentSubtitle' }"
                                    class="invoiceTxCategory"
                                />
                            </VBox>
                            <Text text="{ path: 'Date', formatter: 'formatter.formatDate' }" class="transactionDate" />
                        </HBox>
                    </CustomListItem>
                </List>

                <Title
                    text="{i18n>transactionCategoryField}"
                    level="H5"
                    class="sapUiMediumMarginTop"
                />

                <List
                    id="transactionCategoryList"
                    items="{
                        path: '/Categories',
                        sorter: { path: 'Name', descending: false },
                        parameters: {
                            $select: 'ID,Name',
                            $filter: '(IsActiveEntity eq false or SiblingEntity/IsActiveEntity eq null)'
                        }
                    }"
                    mode="SingleSelectMaster"
                    selectionChange="handler.onCategoryChanged"
                    noDataText="{i18n>categoriesNoData}"
                    class="shareList"
                >
                    <CustomListItem type="Active">
                        <HBox
                            alignItems="Center"
                            class="sapUiTinyMarginTopBottom"
                        >
                            <Avatar
                                src="{ parts: [ { path: 'ID' }, { path: 'ui>/transactionCategory/categoryImages' } ], formatter: 'formatter.cardImageValue' }"
                                initials="{ parts: [ { path: 'Name' } ], formatter: 'formatter.initials' }"
                                displayShape="Circle"
                                class="invoiceCategoryAvatar sapUiTinyMarginEnd"
                            />
                            <Text text="{Name}" class="transactionTitle" />
                        </HBox>
                    </CustomListItem>
                </List>
            </VBox>
        </content>
        <beginButton>
            <Button
                text="{i18n>transactionCategorySaveButton}"
                icon="sap-icon://save"
                type="Emphasized"
                press="handler.onApplyCategory"
            />
        </beginButton>
        <endButton>
            <Button
                text="{i18n>transactionCategoryCancelButton}"
                icon="sap-icon://decline"
                type="Transparent"
                press="handler.onCancelCategory"
            />
        </endButton>
    </Dialog>
</core:FragmentDefinition>