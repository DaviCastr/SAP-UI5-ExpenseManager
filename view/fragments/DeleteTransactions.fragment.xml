<core:FragmentDefinition
    xmlns:core="sap.ui.core"
    xmlns="sap.m"
    id="DeleteTransactions"
    core:require="{
        formatter: 'apps/dflc/expensemanager/util/format',
        handler: 'apps/dflc/expensemanager/controller/fragments/DeleteTransactions'
    }"
>
    <Dialog
        id="deleteTransactionsDialog"
        title="{i18n>deleteTransactionsTitle}"
        class="financeDialog"
        contentWidth="46rem"
        stretch="{device>/system/stretchDialogs}"
        beforeOpen="handler.onDialogBeforeOpen"
        afterClose="handler.onDialogAfterClose"
        busy="{ui>/busy}"
    >
        <content>
            <VBox class="sapUiSmallMargin">
                <MessageStrip
                    text="{i18n>deleteTransactionsIntro}"
                    type="Warning"
                    showIcon="true"
                    class="sapUiSmallMarginBottom"
                />

                <HBox
                    justifyContent="SpaceBetween"
                    alignItems="Center"
                    class="sapUiSmallMarginBottom"
                >
                    <Text
                        text="{ui>/deleteTransactions/countText}"
                        class="invoiceAffectedCount"
                    />
                    <CheckBox
                        id="deleteSelectAll"
                        text="{i18n>deleteTransactionsSelectAll}"
                        selected="{ui>/deleteTransactions/selectAll}"
                        select="handler.onSelectAll"
                    />
                </HBox>

                <List
                    id="deleteTransactionList"
                    mode="MultiSelect"
                    items="{
                        path: '/Transactions',
                        sorter: { path: 'Installment', descending: false },
                        parameters: {
                            $expand: 'Invoice($select=ID,Card_ID,Year,Month;$expand=Card($select=ID)),Currency',
                            $select: 'ID,Identifier,Date,Description,Amount,Installment,TotalInstallments',
                            $filter: '(IsActiveEntity eq false or SiblingEntity/IsActiveEntity eq null)'
                        }
                    }"
                    showSeparators="None"
                    noDataText="{i18n>deleteTransactionsNoData}"
                    class="invoiceTransactionList"
                    updateFinished="handler.onListUpdated"
                    selectionChange="handler.onSelectionChanged"
                >
                    <CustomListItem>
                        <HBox
                            width="100%"
                            alignItems="Center"
                            justifyContent="SpaceBetween"
                            class="sapUiTinyMarginTopBottom deleteTxItem"
                        >
                            <VBox class="sapUiTinyMarginBegin">
                                <Text text="{Description}" class="transactionTitle" />
                                <Text
                                    text="{ parts: [ { path: 'Installment' }, { path: 'TotalInstallments' }, { path: 'Invoice/Year' }, { path: 'Invoice/Month' } ], formatter: 'formatter.installmentSubtitle' }"
                                    class="transactionDate"
                                />
                            </VBox>
                            <Text text="{ path: 'Date', formatter: 'formatter.formatDate' }" class="transactionDate" />
                            <ObjectNumber
                                number="{
                                    parts: [
                                        { path: 'Amount' },
                                        { path: 'Currency/code' }
                                    ],
                                    formatter: 'formatter.formatCurrency'
                                }"
                                class="transactionAmount"
                            />
                        </HBox>
                    </CustomListItem>
                </List>
            </VBox>
        </content>
        <beginButton>
            <Button
                text="{i18n>deleteTransactionsDeleteButton}"
                icon="sap-icon://delete"
                type="Reject"
                press="handler.onDeleteConfirmed"
            />
        </beginButton>
        <endButton>
            <Button
                text="{i18n>deleteTransactionsCancelButton}"
                icon="sap-icon://decline"
                type="Transparent"
                press="handler.onCancelDelete"
            />
        </endButton>
    </Dialog>
</core:FragmentDefinition>