<core:FragmentDefinition
    xmlns:core="sap.ui.core"
    xmlns="sap.m"
    xmlns:f="sap.f"
    xmlns:l="sap.ui.layout"
    id="Liabilities"
    core:require="{
        formatter: 'apps/dflc/expensemanager/util/format',
        handler: 'apps/dflc/expensemanager/controller/fragments/Liabilities'
    }"
>
    <Dialog
        id="liabilitiesDialog"
        title="{i18n>liabilitiesDialogTitle}"
        class="financeDialog"
        contentWidth="54rem"
        stretch="{device>/system/phone}"
        beforeOpen="handler.onDialogBeforeOpen"
        afterOpen="handler.onDialogAfterOpen"
        afterClose="handler.onDialogAfterClose"
        busy="{ui>/busy}"
    >
        <content>
            <VBox class="sapUiSmallMargin">
                <MessageStrip
                    text="{i18n>liabilitiesDialogIntro}"
                    type="Information"
                    showIcon="true"
                    class="sapUiSmallMarginBottom"
                />

                <VBox class="cardManagerAddRow sapUiSmallMarginBottom">
                    <Label
                        text="{i18n>liabilitiesAddLabel}"
                        labelFor="newLiabilityName"
                        class="cardManagerAddTitle"
                    />
                    <HBox
                        wrap="Wrap"
                        alignItems="End"
                        class="sapUiTinyMarginTop"
                    >
                        <VBox class="dialogFormField sapUiTinyMarginEnd sapUiTinyMarginBottom">
                            <layoutData>
                                <FlexItemData
                                    minWidth="10rem"
                                    growFactor="1"
                                />
                            </layoutData>
                            <Label
                                text="{i18n>liabilitiesNameLabel}"
                                labelFor="newLiabilityName"
                            />
                            <Input
                                id="newLiabilityName"
                                value="{ui>/newLiability/name}"
                                placeholder="{i18n>liabilitiesNamePlaceholder}"
                                width="100%"
                            />
                        </VBox>
                        <VBox class="dialogFormField sapUiTinyMarginEnd sapUiTinyMarginBottom">
                            <layoutData>
                                <FlexItemData
                                    minWidth="6rem"
                                />
                            </layoutData>
                            <Label
                                text="{i18n>liabilitiesTotalAmountLabel}"
                                labelFor="newLiabilityTotalAmount"
                            />
                            <Input
                                id="newLiabilityTotalAmount"
                                value="{ path: 'ui>/newLiability/totalAmount', type: 'apps/dflc/expensemanager/util/DecimalInput' }"
                                width="100%"
                            />
                        </VBox>
                        <VBox class="dialogFormField sapUiTinyMarginEnd sapUiTinyMarginBottom">
                            <layoutData>
                                <FlexItemData
                                    minWidth="7rem"
                                />
                            </layoutData>
                            <Label
                                text="{i18n>liabilitiesCurrencyLabel}"
                                labelFor="newLiabilityCurrency"
                            />
                            <Select
                                id="newLiabilityCurrency"
                                selectedKey="{ui>/newLiability/currency}"
                                width="100%"
                            >
                                <core:Item
                                    key="BRL"
                                    text="Real brasileiro (BRL)"
                                />
                                <core:Item
                                    key="USD"
                                    text="Dólar americano (USD)"
                                />
                            </Select>
                        </VBox>
                        <VBox class="dialogFormField sapUiTinyMarginEnd sapUiTinyMarginBottom">
                            <layoutData>
                                <FlexItemData
                                    minWidth="6.5rem"
                                />
                            </layoutData>
                            <Label
                                text="{i18n>liabilitiesDueDayLabel}"
                                labelFor="newLiabilityDueDay"
                            />
                            <StepInput
                                id="newLiabilityDueDay"
                                value="{ui>/newLiability/dueDay}"
                                min="1"
                                max="31"
                                width="100%"
                            />
                        </VBox>
                        <VBox class="dialogFormField sapUiTinyMarginEnd sapUiTinyMarginBottom">
                            <layoutData>
                                <FlexItemData
                                    minWidth="10rem"
                                    growFactor="1"
                                />
                            </layoutData>
                            <Label
                                text="{i18n>liabilitiesDescriptionLabel}"
                                labelFor="newLiabilityDescription"
                            />
                            <Input
                                id="newLiabilityDescription"
                                value="{ui>/newLiability/description}"
                                placeholder="{i18n>liabilitiesDescriptionPlaceholder}"
                                width="100%"
                            />
                        </VBox>
                        <Button
                            text="{i18n>liabilitiesAddLabel}"
                            icon="sap-icon://add"
                            type="Emphasized"
                            press="handler.onAddLiability"
                            class="dialogFormAction sapUiTinyMarginBottom"
                        />
                    </HBox>
                </VBox>

                <List
                    id="liabilitiesList"
                    items="{Liabilities}"
                    mode="None"
                    growing="true"
                    noDataText="{i18n>liabilitiesNoData}"
                    class="shareList cardManagerList"
                >
                    <CustomListItem
                        class="cardManagerCard sapUiTinyMarginBottom"
                    >
                        <Panel
                            accessibleRole="Region"
                            class="sapUiNoContentPadding"
                        >
                            <headerToolbar>
                                <Toolbar
                                    height="auto"
                                    class="sapUiTinyMarginTopBottom"
                                >
                                    <f:Avatar
                                        src="sap-icon://loan"
                                        displaySize="XS"
                                        class="sapUiTinyMarginEnd"
                                    />

                                    <Title
                                        text="{Name}"
                                        level="H5"
                                        class="sapUiTinyMarginEnd"
                                    />

                                    <ToolbarSpacer />

                                    <Button
                                        icon="sap-icon://activity-items"
                                        type="Transparent"
                                        tooltip="{i18n>liabilitiesMovementsTooltip}"
                                        press="handler.onViewTransactions"
                                    />

                                    <!-- Edit button -->
                                    <Button
                                        icon="sap-icon://edit"
                                        type="Transparent"
                                        tooltip="{i18n>liabilitiesEditTooltip}"
                                        visible="{
                                            parts: [
                                                {
                                                    path: 'ui>/liabilityEditId',
                                                    targetType: 'any'
                                                },
                                                {
                                                    path: 'ID',
                                                    targetType: 'any'
                                                }
                                            ],
                                            formatter: 'formatter.isLiabilityNotBeingEdited'
                                        }"
                                        press="handler.onToggleEdit"
                                    />

                                    <!-- Finish edit button -->
                                    <Button
                                        icon="sap-icon://accept"
                                        type="Transparent"
                                        tooltip="{i18n>liabilitiesFinishEditTooltip}"
                                        visible="{
                                            parts: [
                                                {
                                                    path: 'ui>/liabilityEditId',
                                                    targetType: 'any'
                                                },
                                                {
                                                    path: 'ID',
                                                    targetType: 'any'
                                                }
                                            ],
                                            formatter: 'formatter.isLiabilityBeingEdited'
                                        }"
                                        press="handler.onToggleEdit"
                                    />

                                    <Button
                                        icon="sap-icon://delete"
                                        type="Transparent"
                                        tooltip="{i18n>liabilitiesRemoveTooltip}"
                                        press="handler.onRemoveLiability"
                                    />
                                </Toolbar>
                            </headerToolbar>

                            <content>
                                <!-- ==================== -->
                                <!-- VIEW MODE             -->
                                <!-- ==================== -->
                                <VBox
                                    class="liabilityView"
                                    visible="{
                                        parts: [
                                            {
                                                path: 'ui>/liabilityEditId',
                                                targetType: 'any'
                                            },
                                            {
                                                path: 'ID',
                                                targetType: 'any'
                                            }
                                        ],
                                        formatter: 'formatter.isLiabilityNotBeingEdited'
                                    }"  
                                >
                                    <HBox
                                        wrap="Wrap"
                                        alignItems="Center"
                                        class="liabilityRow"
                                    >
                                        <ObjectStatus
                                            text="{
                                                path: 'Status',
                                                formatter: 'formatter.liabilityStatusText'
                                            }"
                                            state="{
                                                path: 'Status',
                                                formatter: 'formatter.liabilityStatusState'
                                            }"
                                        />
                                    </HBox>

<HBox
                                        wrap="Wrap"
                                        alignItems="Center"
                                        class="liabilityRow"
                                    >
                                        <VBox class="liabilityGridField sapUiTinyMarginEnd">
                                            <layoutData>
                                                <FlexItemData
                                                    minWidth="8rem"
                                                    growFactor="1"
                                                />
                                            </layoutData>
                                            <Label
                                                text="{i18n>liabilitiesOutstandingBalanceLabel}"
                                                class="liabilityFieldLabel"
                                            />

                                            <ObjectNumber
                                                number="{
                                                    parts: [
                                                        { path: 'OutstandingBalance' },
                                                        { path: 'Currency_code' }
                                                    ],
                                                    formatter: 'formatter.formatCardAmount'
                                                }"
                                                class="liabilityAmount"
                                            />
                                        </VBox>

                                        <VBox class="liabilityGridField sapUiTinyMarginEnd">
                                            <layoutData>
                                                <FlexItemData
                                                    minWidth="8rem"
                                                    growFactor="1"
                                                />
                                            </layoutData>
                                            <Label
                                                text="{i18n>liabilitiesTotalAmountLabel}"
                                                class="liabilityFieldLabel"
                                            />

                                            <ObjectNumber
                                                number="{
                                                    parts: [
                                                        { path: 'TotalAmount' },
                                                        { path: 'Currency_code' }
                                                    ],
                                                    formatter: 'formatter.formatCardAmount'
                                                }"
                                                class="liabilityAmount"
                                            />
                                        </VBox>

                                        <VBox class="liabilityGridField sapUiTinyMarginEnd">
                                            <layoutData>
                                                <FlexItemData
                                                    minWidth="9rem"
                                                    growFactor="2"
                                                />
                                            </layoutData>
                                            <Label
                                                text="{i18n>liabilitiesProgressLabel}"
                                                class="liabilityFieldLabel"
                                            />

                                            <ProgressIndicator
                                                percentValue="{
                                                    path: 'PaymentPercentage',
                                                    formatter: 'formatter.liabilityProgressValue'
                                                }"
                                                displayValue="{
                                                    path: 'PaymentPercentage',
                                                    formatter: 'formatter.liabilityProgressText'
                                                }"
                                                state="None"
                                                width="100%"
                                                class="liabilityProgress"
                                            />
                                        </VBox>

                                        <VBox class="liabilityGridField sapUiTinyMarginEnd">
                                            <layoutData>
                                                <FlexItemData
                                                    minWidth="8rem"
                                                    growFactor="1"
                                                />
                                            </layoutData>
                                            <Label
                                                text="{i18n>liabilitiesDueDayLabel}"
                                                class="liabilityFieldLabel"
                                            />

                                            <Text
                                                text="{
                                                    parts: [
                                                        { path: 'i18n>liabilitiesDueDayText' },
                                                        { path: 'DueDay' }
                                                    ],
                                                    formatter: 'formatter.formatTemplate'
                                                }"
                                            />
                                        </VBox>
                                    </HBox>

                                    <Text
                                        text="{Description}"
                                        visible="{= ${Description} !== '' }"
                                        class="liabilityMuted sapUiTinyMarginTop"
                                    />
                                </VBox>

                                <!-- ==================== -->
                                <!-- EDIT MODE             -->
                                <!-- ==================== -->
                                <VBox
                                    class="liabilityEdit"
                                    visible="{
                                        parts: [
                                            {
                                                path: 'ui>/liabilityEditId',
                                                targetType: 'any'
                                            },
                                            {
                                                path: 'ID',
                                                targetType: 'any'
                                            }
                                        ],
                                        formatter: 'formatter.isLiabilityBeingEdited'
                                    }"
                                >
                                    <HBox
                                        wrap="Wrap"
                                        alignItems="End"
                                        class="liabilityRow"
                                    >
<VBox
                                            class="dialogFormField sapUiTinyMarginEnd sapUiTinyMarginBottom"
                                        >
                                            <layoutData>
                                                <FlexItemData
                                                    minWidth="10rem"
                                                    growFactor="1"
                                                />
                                            </layoutData>
                                            <Label
                                                text="{i18n>liabilitiesNameLabel}"
                                            />

                                            <Input
                                                value="{Name}"
                                                width="100%"
                                            />
                                        </VBox>

                                        <VBox
                                            class="dialogFormField sapUiTinyMarginEnd sapUiTinyMarginBottom"
                                        >
                                            <layoutData>
                                                <FlexItemData
                                                    minWidth="6rem"
                                                />
                                            </layoutData>
                                            <Label
                                                text="{i18n>liabilitiesTotalAmountLabel}"
                                            />

                                            <Input
                                                value="{ path: 'TotalAmount', type: 'apps/dflc/expensemanager/util/DecimalInput' }"
                                                width="100%"
                                            />
                                        </VBox>

                                        <VBox
                                            class="dialogFormField sapUiTinyMarginEnd sapUiTinyMarginBottom"
                                        >
                                            <layoutData>
                                                <FlexItemData
                                                    minWidth="7rem"
                                                />
                                            </layoutData>
                                            <Label
                                                text="{i18n>liabilitiesCurrencyLabel}"
                                            />

                                            <Text
                                                text="{ path: 'Currency_code', formatter: 'formatter.currencyDisplayName' }"
                                                width="100%"
                                                wrapping="false"
                                            />
                                        </VBox>

                                        <VBox
                                            class="dialogFormField sapUiTinyMarginEnd sapUiTinyMarginBottom"
                                        >
                                            <layoutData>
                                                <FlexItemData
                                                    minWidth="6.5rem"
                                                />
                                            </layoutData>
                                            <Label
                                                text="{i18n>liabilitiesDueDayLabel}"
                                            />

                                            <StepInput
                                                value="{DueDay}"
                                                min="1"
                                                max="31"
                                                width="100%"
                                            />
                                        </VBox>

                                        <VBox
                                            class="dialogFormField sapUiTinyMarginEnd sapUiTinyMarginBottom"
                                        >
                                            <layoutData>
                                                <FlexItemData
                                                    minWidth="10rem"
                                                    growFactor="2"
                                                />
                                            </layoutData>
                                            <Label
                                                text="{i18n>liabilitiesDescriptionLabel}"
                                            />

                                            <Input
                                                value="{Description}"
                                                width="100%"
                                            />
                                        </VBox>
                                    </HBox>
                                </VBox>
                            </content>
                        </Panel>
                    </CustomListItem>
                </List>
            </VBox>
        </content>
        <buttons>
            <Button
                text="{i18n>liabilitiesSaveButton}"
                icon="sap-icon://save"
                type="Emphasized"
                press="handler.onSaveLiabilities"
            />
            <Button
                text="{i18n>liabilitiesCancelButton}"
                icon="sap-icon://cancel"
                press="handler.onCancelLiabilities"
            />
            <Button
                text="{i18n>liabilitiesDiscardButton}"
                type="Transparent"
                press="handler.onDiscardLiabilities"
            />
        </buttons>
    </Dialog>
</core:FragmentDefinition>
