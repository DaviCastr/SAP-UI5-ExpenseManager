<core:FragmentDefinition
    xmlns:core="sap.ui.core"
    xmlns="sap.m"
    xmlns:u="sap.ui.unified"
    xmlns:f="sap.ui.layout.form"
    xmlns:l="sap.ui.layout"
    xmlns:mvc="sap.ui.core.mvc"
    id="PersonDetail"
    core:require="{
        formatter: 'apps/dflc/expensemanager/util/format',
        handler: 'apps/dflc/expensemanager/controller/fragments/EditPerson'
    }"
>
    <Dialog
        id="personDetailDialog"
        title="{i18n>personDetailTitle}"
        class="financeDialog"
        contentWidth="42rem"
        stretch="{device>/system/stretchDialogs}" 
        beforeOpen="handler.onDialogBeforeOpen"
        afterOpen="handler.onDialogAfterOpen"
        afterClose="handler.onDialogAfterClose"
        busy="{ui>/busy}"
    >
        <!-- O ScrollContainer foi removido pois o Dialog já faz a rolagem automaticamente quando necessário -->
        <content>
            <VBox class="sapUiSmallMargin">
                
                <!-- Cabeçalho (Avatar e Textos) -->
                <HBox alignItems="Center" class="sapUiSmallMarginBottom">
                    <Avatar
                        id="editPersonAvatar"
                        displaySize="Custom"
                        customDisplaySize="5rem"
                        displayShape="Circle"
                        initials="{ path: 'Name', formatter: 'formatter.initials' }"
                        src="{ui>/selectedPersonImage}"
                        class="sapUiMediumMarginEnd"
                    />
                    <VBox>
                        <Title
                            text="{Name}"
                            level="H2"
                            class="sapUiTinyMarginBottom"
                        />
                        <Text
                            text="{i18n>personDetailIntro}"
                        />
                    </VBox>
                </HBox>

                <!-- Área de Upload de Foto -->
                <VBox class="sapUiSmallMarginBottom">
                    <u:FileUploader
                        id="editPersonFileUploader"
                        buttonText="{i18n>personPhotoButton}"
                        placeholder="{i18n>personPhotoPlaceholder}"
                        fileType="png,jpg,jpeg"
                        uploadOnChange="false"
                        multiple="false"
                        sendXHR="true"
                        httpRequestMethod="PUT"
                        useMultipart="false"
                        enabled="{ui>/managerDialogInDraft}"
                        change="handler.onPhotoChanged"
                        width="100%"
                    />
                </VBox>

                <!-- Formulário Responsivo -->
                <f:Form editable="true">
                    <f:layout>
                        <!-- Configuração Fiori Padrão: 
                             No PC e Tablet (L e M) -> Label ocupa 4 colunas (fica ao lado do campo).
                             No Mobile (S) -> Label ocupa 12 colunas (fica em cima do campo).
                        -->
                        <f:ResponsiveGridLayout
                            labelSpanXL="4"
                            labelSpanL="4"
                            labelSpanM="4"
                            labelSpanS="12"
                            adjustLabelSpan="false"
                            emptySpanXL="0"
                            emptySpanL="0"
                            emptySpanM="0"
                            emptySpanS="0"
                            columnsXL="1"
                            columnsL="1"
                            columnsM="1"
                        />
                    </f:layout>
                    
                    <f:formContainers>
                        <!-- Grupo 1: Dados Básicos -->
                        <f:FormContainer title="{i18n>personFormBasicTitle}">
                            <f:formElements>
                                <f:FormElement label="{i18n>personNameLabel}">
                                    <f:fields>
                                        <Input
                                            value="{Name}"
                                            enabled="{ui>/managerDialogInDraft}"
                                            placeholder="{i18n>personNamePlaceholder}"
                                        />
                                    </f:fields>
                                </f:FormElement>
                                <f:FormElement label="{i18n>personEmailLabel}">
                                    <f:fields>
                                        <Input
                                            value="{Email}"
                                            type="Email"
                                            enabled="{ui>/managerDialogInDraft}"
                                            placeholder="{i18n>personEmailPlaceholder}"
                                        />
                                    </f:fields>
                                </f:FormElement>
                                <f:FormElement label="{i18n>personPhoneLabel}">
                                    <f:fields>
                                        <Input
                                            value="{Phone}"
                                            enabled="{ui>/managerDialogInDraft}"
                                            placeholder="{i18n>personPhonePlaceholder}"
                                        />
                                    </f:fields>
                                </f:FormElement>
                            </f:formElements>
                        </f:FormContainer>

                        <!-- Grupo 2: Finanças -->
                        <f:FormContainer title="{i18n>personFormFinanceTitle}">
                            <f:formElements>
                                <f:FormElement label="{i18n>personIncomeLabel}">
                                    <f:fields>
                                        <Input
                                            value="{Income}"
                                            enabled="{ui>/managerDialogInDraft}"
                                            placeholder="{i18n>personIncomePlaceholder}"
                                        />
                                    </f:fields>
                                </f:FormElement>
                                <f:FormElement label="{i18n>personTargetLabel}">
                                    <f:fields>
                                        <Input
                                            value="{ExpenseTarget}"
                                            enabled="{ui>/managerDialogInDraft}"
                                            placeholder="{i18n>personTargetPlaceholder}"
                                        />
                                    </f:fields>
                                </f:FormElement>
                                <f:FormElement label="{i18n>personCurrencyLabel}">
                                    <f:fields>
                                        <Select
                                            id="editPersonCurrency"
                                            selectedKey="{Currency_code}"
                                            enabled="{ui>/managerDialogInDraft}"
                                        >
                                            <core:Item
                                                key="BRL"
                                                text="Real brasileiro (BRL)"
                                            />
                                            <core:Item
                                                key="USD"
                                                text="Dólar americano (USD)"
                                            />
                                        </Select>
                                    </f:fields>
                                </f:FormElement>
                            </f:formElements>
                        </f:FormContainer>

                        <!-- Grupo 3: Totais (Apenas leitura) -->
                        <f:FormContainer title="{i18n>personFormTotalsTitle}">
                            <f:formElements>
                                <f:FormElement label="{i18n>personTotalExpensesLabel}">
                                    <f:fields>
                                        <ObjectNumber
                                            number="{
                                                parts: [ { path: 'ui>/periodTotals/TotalExpenses' }, { path: 'ui>/periodTotals/CurrencyCode' } ],
                                                formatter: 'formatter.formatCardAmount'
                                            }"
                                        />
                                    </f:fields>
                                </f:FormElement>
                                <f:FormElement label="{i18n>personTotalExpensesMonthLabel}">
                                    <f:fields>
                                        <ObjectNumber
                                            number="{
                                                parts: [ { path: 'ui>/periodTotals/MonthExpenses' }, { path: 'ui>/periodTotals/CurrencyCode' } ],
                                                formatter: 'formatter.formatCardAmount'
                                            }"
                                            state="{ path: 'ui>/periodTotals/MonthCriticallity', formatter: 'formatter.criticalityState' }"
                                        />
                                    </f:fields>
                                </f:FormElement>
                                <f:FormElement label="{i18n>personTotalLiabilitiesMonthLabel}">
                                    <f:fields>
                                        <ObjectNumber
                                            number="{
                                                parts: [ { path: 'ui>/periodTotals/MonthLiabilitiesExpenses' }, { path: 'ui>/periodTotals/CurrencyCode' } ],
                                                formatter: 'formatter.formatCardAmount'
                                            }"
                                        />
                                    </f:fields>
                                </f:FormElement>
                                <f:FormElement label="{i18n>personTotalMonthCombinedLabel}">
                                    <f:fields>
                                        <ObjectNumber
                                            number="{
                                                parts: [ { path: 'ui>/periodTotals/MonthTotalExpenses' }, { path: 'ui>/periodTotals/CurrencyCode' } ],
                                                formatter: 'formatter.formatCardAmount'
                                            }"
                                        />
                                    </f:fields>
                                </f:FormElement>
                                <f:FormElement label="{i18n>personTotalExpensesClosedLabel}">
                                    <f:fields>
                                        <ObjectNumber
                                            number="{
                                                parts: [ { path: 'ui>/periodTotals/MonthExpensesClosed' }, { path: 'ui>/periodTotals/CurrencyCode' } ],
                                                formatter: 'formatter.formatCardAmount'
                                            }"
                                        />
                                    </f:fields>
                                </f:FormElement>
                                <f:FormElement label="{i18n>personTotalExpensesPayedLabel}">
                                    <f:fields>
                                        <ObjectNumber
                                            number="{
                                                parts: [ { path: 'ui>/periodTotals/MonthExpensesPayed' }, { path: 'ui>/periodTotals/CurrencyCode' } ],
                                                formatter: 'formatter.formatCardAmount'
                                            }"
                                        />
                                    </f:fields>
                                </f:FormElement>
                                <f:FormElement label="{i18n>personTotalExpensesToPayLabel}">
                                    <f:fields>
                                        <ObjectNumber
                                            number="{
                                                parts: [ { path: 'ui>/periodTotals/MonthExpensesToPay' }, { path: 'ui>/periodTotals/CurrencyCode' } ],
                                                formatter: 'formatter.formatCardAmount'
                                            }"
                                            state="{ path: 'ui>/periodTotals/CriticallityToPay', formatter: 'formatter.criticalityState' }"
                                        />
                                    </f:fields>
                                </f:FormElement>
                            </f:formElements>
                        </f:FormContainer>
                    </f:formContainers>
                </f:Form>
            </VBox>
        </content>
        
        <buttons>
            <!-- Salvar/Descartar só existem durante a edição (rascunho aberto) -->
            <Button
                text="{i18n>personSaveButtonEdit}"
                icon="sap-icon://accept"
                type="Emphasized"
                visible="{ui>/managerDialogInDraft}"
                press="handler.onSavePerson"
            />
            <Button
                text="{i18n>personDiscardButton}"
                icon="sap-icon://delete"
                type="Reject"
                visible="{ui>/managerDialogInDraft}"
                press="handler.onDiscardDraft"
            />
            <!-- Edita sob demanda: cria/usa o rascunho da pessoa (só fora da edição) -->
            <Button
                text="{i18n>personEditInsideButton}"
                icon="sap-icon://edit"
                type="Emphasized"
                tooltip="{i18n>personEditInsideTooltip}"
                visible="{=!${ui>/managerDialogInDraft}}"
                press="handler.onTogglePersonEdit"
            />
            <!-- Alterado para tipo Transparent para diminuir a poluição visual -->
            <Button
                text="{i18n>personCancelButton}"
                icon="sap-icon://decline"
                type="Transparent"
                press="handler.onCancelEdit"
            />
        </buttons>
    </Dialog>
</core:FragmentDefinition>