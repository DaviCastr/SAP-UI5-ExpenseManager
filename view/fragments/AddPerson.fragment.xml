<core:FragmentDefinition
    xmlns:core="sap.ui.core"
    xmlns="sap.m"
    xmlns:u="sap.ui.unified"
    id="AddPerson"
>
    <Dialog
        id="personDialog"
        title="{i18n>personDialogTitle}"
        class="financeDialog"
        contentWidth="30rem"
        busy="{ui>/busy}"
        beforeOpen="handler.onDialogBeforeOpen"
        core:require="{ handler: 'apps/dflc/expensemanager/controller/fragments/AddPerson' }"
    >
        <content>
            <ScrollContainer height="30rem" vertical="true">
                <VBox class="dialogContent">
                    <Text text="{i18n>personDialogIntro}" class="dialogIntro" />
                    <Avatar
                        id="personAvatar"
                        displaySize="Custom"
                        customDisplaySize="5.5rem"
                        displayShape="Circle"
                        initials="P"
                        class="sapUiTinyMarginBottom"
                    />
                    <u:FileUploader
                        id="personFileUploader"
                        buttonText="{i18n>personPhotoButton}"
                        placeholder="{i18n>personPhotoPlaceholder}"
                        fileType="png,jpg,jpeg"
                        uploadOnChange="false"
                        multiple="false"
                        sendXHR="true"
                        httpRequestMethod="PUT"
                        useMultipart="false"
                        change="handler.onPhotoChanged"
                        width="100%"
                    />
                    <Label text="{i18n>personNameLabel}" labelFor="personName" />
                    <Input id="personName" value="{ui>/newPerson/name}" placeholder="{i18n>personNamePlaceholder}" />
                    <Label text="{i18n>personEmailLabel}" labelFor="personEmail" />
                    <Input id="personEmail" value="{ui>/newPerson/email}" type="Email" placeholder="{i18n>personEmailPlaceholder}" />
                    <Label text="{i18n>personPhoneLabel}" labelFor="personPhone" />
                    <Input id="personPhone" value="{ui>/newPerson/phone}" placeholder="{i18n>personPhonePlaceholder}" />
                    <Label text="{i18n>personIncomeLabel}" labelFor="personIncome" />
                    <Input id="personIncome" value="{ui>/newPerson/income}" type="Number" placeholder="{i18n>personIncomePlaceholder}" />
                    <Label text="{i18n>personCurrencyLabel}" labelFor="personCurrency" />
                    <Select id="personCurrency" selectedKey="{ui>/newPerson/currency}">
                        <core:Item key="BRL" text="Real brasileiro (BRL)" />
                        <core:Item key="USD" text="Dólar americano (USD)" />
                    </Select>
                    <Label text="{i18n>personTargetLabel}" labelFor="personTarget" />
                    <Input id="personTarget" value="{ui>/newPerson/target}" type="Number" placeholder="{i18n>personTargetPlaceholder}" />
                </VBox>
            </ScrollContainer>
        </content>
        <beginButton><Button text="{i18n>personSaveButton}" icon="sap-icon://accept" type="Emphasized" enabled="{= !${ui>/busy}}" press="handler.onAddPerson" /></beginButton>
        <endButton><Button text="{i18n>personCancelButton}" icon="sap-icon://decline" press="handler.onCancelPerson" /></endButton>
    </Dialog>
</core:FragmentDefinition>
