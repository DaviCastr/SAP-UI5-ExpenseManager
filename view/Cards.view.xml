<mvc:View
    controllerName="apps.dflc.expensemanager.controller.Cards"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns:core="sap.ui.core"
    xmlns="sap.m"
    xmlns:u="sap.ui.unified"
    core:require="{
        formatter: 'apps/dflc/expensemanager/util/format'
    }"
>
    <VBox id="cardsPage" class="tabPage" busy="{ui>/busy}">
        <HBox justifyContent="SpaceBetween" alignItems="Center" wrap="Wrap" class="tabPageHeader">
            <VBox>
                <Title text="{i18n>cardsDialogTitle}" level="H2" class="tabPageTitle" />
                <Text text="{i18n>cardsTabIntro}" class="sectionHint" />
            </VBox>
            <Button
                text="{i18n>cardsEditTooltip}"
                icon="sap-icon://edit"
                type="Emphasized"
                press=".onToggleEdit"
                visible="{= !${ui>/selectedPersonDraft} }"
            />
        </HBox>

        <VBox class="surfaceCard cardAddPanel">
            <HBox alignItems="Center" class="cardAddHeader">
                <core:Icon src="sap-icon://add-activity" class="cardAddIcon" />
                <Title text="{i18n>cardsAddLabel}" level="H3" />
            </HBox>
            <HBox wrap="Wrap" alignItems="End" class="cardAddFields">
                <VBox class="cardAddField cardAddFieldWide">
                    <Label text="{i18n>cardNameLabel}" labelFor="newCardName" />
                    <Input id="newCardName" value="{ui>/newCard/name}" placeholder="{i18n>cardNamePlaceholder}" />
                </VBox>
                <VBox class="cardAddField">
                    <Label text="{i18n>cardLimitLabel}" labelFor="newCardLimit" />
                    <Input
                        id="newCardLimit"
                        value="{ path: 'ui>/newCard/limit', type: 'apps/dflc/expensemanager/util/DecimalInput' }"
                        placeholder="{i18n>cardLimitPlaceholder}"
                    />
                </VBox>
                <VBox class="cardAddField">
                    <Label text="{i18n>cardCurrencyLabel}" labelFor="newCardCurrency" />
                    <Select id="newCardCurrency" selectedKey="{ui>/newCard/currency}" width="100%">
                        <core:Item key="BRL" text="Real brasileiro (BRL)" />
                        <core:Item key="USD" text="Dólar americano (USD)" />
                    </Select>
                </VBox>
                <VBox class="cardAddField cardAddFieldDay">
                    <Label text="{i18n>cardsClosingLabel}" labelFor="newCardClosing" />
                    <Input
                        id="newCardClosing"
                        value="{ path: 'ui>/newCard/closingDay', type: 'apps/dflc/expensemanager/util/DecimalInput' }"
                        placeholder="{i18n>cardsDayPlaceholder}"
                    />
                </VBox>
                <VBox class="cardAddField cardAddFieldDay">
                    <Label text="{i18n>cardsDueLabel}" labelFor="newCardDue" />
                    <Input
                        id="newCardDue"
                        value="{ path: 'ui>/newCard/dueDay', type: 'apps/dflc/expensemanager/util/DecimalInput' }"
                        placeholder="{i18n>cardsDayPlaceholder}"
                    />
                </VBox>
                <Button
                    id="addCardButton"
                    text="{i18n>cardsAddLabel}"
                    icon="sap-icon://add"
                    type="Emphasized"
                    press=".onAdd"
                    class="cardAddButton"
                />
            </HBox>
        </VBox>

        <List
            id="cardsList"
            items="{Cards}"
            mode="None"
            growing="true"
            growingThreshold="30"
            showSeparators="None"
            noDataText="{i18n>cardsNoData}"
            class="cardTileList"
        >
            <CustomListItem class="cardTile">
                <VBox class="cardTileBody">
                    <HBox alignItems="Center" class="cardTileHeader">
                        <Avatar
                            src="{ parts: [ { path: 'ID' }, { path: 'ui>/dialogCardImages' } ], formatter: 'formatter.cardImageValue' }"
                            displaySize="Custom"
                            customDisplaySize="3rem"
                            displayShape="Square"
                            initials="{ parts: [ { path: 'Name' } ], formatter: 'formatter.initials' }"
                            class="cardManagerAvatar cardTileAvatar"
                        />
                        <VBox class="cardTileTitle">
                            <Title text="{Name}" level="H4" wrapping="true" visible="{= !${ui>/selectedPersonDraft} }" />
                            <Input
                                value="{Name}"
                                placeholder="{i18n>cardNamePlaceholder}"
                                visible="{ui>/selectedPersonDraft}"
                                class="cardManagerInput"
                            />
                        </VBox>
                        <u:FileUploader
                            buttonOnly="true"
                            iconOnly="true"
                            icon="sap-icon://camera"
                            buttonType="Transparent"
                            tooltip="{i18n>cardsPhotoButton}"
                            fileType="png,jpg,jpeg"
                            uploadOnChange="false"
                            multiple="false"
                            sendXHR="true"
                            httpRequestMethod="PUT"
                            useMultipart="false"
                            change=".onPhotoChanged"
                            visible="{ui>/selectedPersonDraft}"
                            class="cardManagerPhoto"
                        />
                        <Button
                            icon="sap-icon://delete"
                            type="Transparent"
                            tooltip="{i18n>cardsRemoveTooltip}"
                            press=".onRemove"
                        />
                    </HBox>

                    <HBox justifyContent="SpaceBetween" alignItems="End" wrap="Wrap" class="cardTileSummary" visible="{= !${ui>/selectedPersonDraft} }">
                        <VBox>
                            <Text text="{i18n>cardLimitLabel}" class="cardTileLabel" />
                            <Text
                                text="{ parts: [ { path: 'Limit' }, { path: 'Currency_code' } ], formatter: 'formatter.formatCardAmount' }"
                                class="cardTileAmount"
                            />
                        </VBox>
                        <Text
                            text="{ parts: [ 'i18n>cardsSchedule', { path: 'ClosingDay' }, { path: 'DueDay' } ], formatter: 'formatter.formatTemplate' }"
                            class="cardTileSchedule"
                        />
                    </HBox>

                    <HBox wrap="Wrap" alignItems="End" class="cardTileFields" visible="{ui>/selectedPersonDraft}">
                        <VBox class="cardTileField">
                            <Label text="{i18n>cardLimitLabel}" />
                            <Input value="{ path: 'Limit', type: 'apps/dflc/expensemanager/util/DecimalInput' }" />
                        </VBox>
                        <VBox class="cardTileField">
                            <Label text="{i18n>cardCurrencyLabel}" />
                            <Select selectedKey="{Currency_code}" forceSelection="false" width="100%">
                                <core:Item key="BRL" text="Real (BRL)" />
                                <core:Item key="USD" text="Dólar (USD)" />
                            </Select>
                        </VBox>
                        <VBox class="cardTileField">
                            <Label text="{i18n>cardsClosingLabel}" />
                            <Input value="{ path: 'ClosingDay', type: 'apps/dflc/expensemanager/util/DecimalInput' }" />
                        </VBox>
                        <VBox class="cardTileField">
                            <Label text="{i18n>cardsDueLabel}" />
                            <Input value="{ path: 'DueDay', type: 'apps/dflc/expensemanager/util/DecimalInput' }" />
                        </VBox>
                    </HBox>
                </VBox>
            </CustomListItem>
        </List>
    </VBox>
</mvc:View>
