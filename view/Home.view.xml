<mvc:View
    controllerName="apps.dflc.expensemanager.controller.Home"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    core:require="{
        formatter: 'apps/dflc/expensemanager/util/format'
    }"
>
    <Page
        id="homePage"
        showHeader="false"
        enableScrolling="true"
        class="financePage"
    >
        <content>
            <VBox class="financeShell">
                <VBox id="personSection">
                    <HBox
                        class="topBar"
                        justifyContent="SpaceBetween"
                        alignItems="Center"
                        wrap="Wrap"
                    >
                        <HBox
                            alignItems="Center"
                            class="brandGroup"
                        >
                            <core:Icon
                                src="sap-icon://wallet"
                                class="brandMark"
                            />
                            <VBox>
                                <Title
                                    text="{i18n>brandTitle}"
                                    level="H2"
                                    class="brandTitle"
                                />
                                <Text
                                    text="{ui>/monthLabel}"
                                    class="brandCaption"
                                />
                            </VBox>
                        </HBox>
                        <HBox
                            alignItems="Center"
                            class="topActions"
                            wrap="Wrap"
                        >
                            <Text
                                text="{i18n>personManageLabel}"
                                class="personLabel"
                            />
                            <Avatar
                                id="personImage"
                                src="{ui>/selectedPersonImage}"
                                initials="{ path: 'ui>/selectedPerson/Name', formatter: 'formatter.initials' }"
                                displaySize="XS"
                                displayShape="Circle"
                                class="personAvatar"
                                visible="{= !${ui>/personsEmpty} }"
                            />
                            <Select
                                id="personSelect"
                                items="{
                                    path: '/Persons',
                                    parameters: {
                                        '$select': 'ID,Name,Income,ExpenseTarget,Currency,ImageType,IsActiveEntity',
                                        '$expand': 'DraftAdministrativeData($select=DraftUUID,InProcessByUser)',
                                        '$filter': '(IsActiveEntity eq true or SiblingEntity/IsActiveEntity eq null)'
                                    }
                                }"
                                selectedKey="{ui>/selectedPersonId}"
                                change=".onPersonChange"
                                class="personSelect"
                                width="12rem"
                                visible="{= !${ui>/personsEmpty} }"
                            >
                                <core:Item
                                    key="{ID}"
                                    text="{= ${Name} + (${IsActiveEntity} === false ? ' (rascunho)' : '')}"
                                />
                            </Select>
                            <Button
                                icon="sap-icon://edit"
                                type="Transparent"
                                tooltip="{i18n>personEditTooltip}"
                                press=".onOpenPersonDetailDialog"
                                class="iconAction"
                                visible="{= !${ui>/personsEmpty} }"
                            />
                            <Button
                                icon="sap-icon://add"
                                type="Transparent"
                                tooltip="{i18n>personAddButton}"
                                press=".onOpenPersonDialog"
                                class="iconAction"
                                visible="{= !${ui>/personsEmpty} }"
                            />
                            <Button
                                icon="sap-icon://log"
                                type="Transparent"
                                tooltip="{i18n>logoutTooltip}"
                                press=".onLogout"
                                class="iconAction"
                            />
                        </HBox>
                    </HBox>

                    <VBox id="personDetails">
                        <HBox
                            visible="{= ${ui>/selectedPersonDraft} &amp;&amp; !${ui>/personsEmpty} }"
                            alignItems="Center"
                            class="sapUiTinyMarginBottom personDraftBanner"
                        >
                            <MessageStrip
                                text="{i18n>personDraftBanner}"
                                type="Warning"
                                showIcon="true"
                                class="sapUiTinyMarginEnd"
                            />
                            <Button
                                text="{i18n>personDiscardButton}"
                                icon="sap-icon://delete"
                                type="Reject"
                                press=".onDiscardPersonDraft"
                            />
                        </HBox>
                        <HBox
                            class="balanceHero"
                            justifyContent="SpaceBetween"
                            alignItems="Stretch"
                            wrap="Wrap"
                            busy="{ui>/busy}"
                            visible="{= !${ui>/personsEmpty} }"
                        >
                            <VBox class="balanceCopy">
                                <Text
                                    text="{i18n>homeEyebrow}"
                                    class="eyebrow"
                                />
                                <Title
                                    text="{ parts: [ { path: 'i18n>helloUser' }, { path: 'Name' } ], formatter: 'formatter.formatTemplate' }"
                                    level="H1"
                                    class="heroTitle"
                                />
                                <Text
                                    text="{i18n>heroGreetingSubtitle}"
                                    class="heroSubtitle"
                                />
                                <HBox
                                    class="heroActions"
                                    wrap="Wrap"
                                >
                                    <Button
                                        text="{i18n>actionRegisterExpense}"
                                        icon="sap-icon://add"
                                        type="Emphasized"
                                        press=".onOpenExpenseDialog"
                                        class="primaryAction"
                                    />
                                    <Button
                                        text="{i18n>actionAddCard}"
                                        icon="sap-icon://credit-card"
                                        type="Transparent"
                                        press=".onOpenCardDialog"
                                        class="secondaryAction"
                                    />
                                    <Button
                                        text="{i18n>actionSimulate}"
                                        icon="sap-icon://customer-view"
                                        type="Transparent"
                                        press=".onOpenSimulationDialog"
                                        class="secondaryAction"
                                    />
                                    <Button
                                        text="{i18n>actionRestoreBackup}"
                                        icon="sap-icon://upload-to-cloud"
                                        type="Transparent"
                                        press=".onRestoreBackup"
                                        class="secondaryAction"
                                    />
                                    <Button
                                        text="{i18n>actionExportBackup}"
                                        icon="sap-icon://download-to-cloud"
                                        type="Transparent"
                                        press=".onExportBackup"
                                        class="secondaryAction"
                                    />
                                </HBox>
                            </VBox>
                            <VBox class="balanceCard">
                                <Text
                                    text="{i18n>balanceAvailableLabel}"
                                    class="balanceLabel"
                                />
                                <ObjectNumber
                                    number="{ui>/summary/available}"
                                    class="balanceNumber"
                                />
                                <HBox
                                    alignItems="Center"
                                    class="balanceTrend"
                                >
                                    <core:Icon src="{ui>/summary/trendIcon}" />
                                    <Text text="{ui>/summary/trendText}" />
                                </HBox>
                            </VBox>
                        </HBox>
                    </VBox>
                </VBox>
                <HBox
                    class="periodNav"
                    justifyContent="SpaceBetween"
                    alignItems="Center"
                    wrap="Wrap"
                    visible="{= !${ui>/personsEmpty} }"
                >
                    <VBox>
                        <Title
                            text="{i18n>periodOverviewTitle}"
                            level="H3"
                        />
                        <Text
                            text="{ui>/monthLabel}"
                            class="sectionHint"
                        />
                    </VBox>
                    <HBox
                        alignItems="Center"
                        class="periodNavActions"
                    >
                        <Button
                            icon="sap-icon://slim-arrow-left"
                            type="Transparent"
                            press=".onPreviousMonth"
                            tooltip="{i18n>previousMonthTooltip}"
                            class="iconAction"
                        />
                        <Button
                            text="{ui>/monthLabel}"
                            type="Transparent"
                            press=".onThisMonth"
                            tooltip="{i18n>currentMonthTooltip}"
                            class="periodNavLabel"
                        />
                        <Button
                            icon="sap-icon://slim-arrow-right"
                            type="Transparent"
                            press=".onNextMonth"
                            tooltip="{i18n>nextMonthTooltip}"
                            class="iconAction"
                        />
                    </HBox>
                </HBox>

                <VBox
                    class="emptyState"
                    visible="{ui>/personsEmpty}"
                    alignItems="Center"
                    justifyContent="Center"
                >
                    <core:Icon
                        src="sap-icon://inbox"
                        class="emptyStateIcon"
                    />
                    <Title
                        text="{i18n>emptyPersonsTitle}"
                        level="H2"
                        class="emptyStateTitle"
                    />
                    <Text
                        text="{i18n>emptyPersonsText}"
                        class="emptyStateText"
                    />
                    <HBox
                        wrap="Wrap"
                        alignItems="Center"
                        justifyContent="Center"
                    >
                        <Button
                            text="{i18n>personAddButton}"
                            icon="sap-icon://person-add"
                            type="Emphasized"
                            press=".onOpenPersonDialog"
                            class="emptyStateButton"
                        />
                        <Button
                            text="{i18n>backupRestoreButton}"
                            icon="sap-icon://upload-to-cloud"
                            type="Transparent"
                            press=".onRestoreBackup"
                            class="emptyStateButton"
                        />
                    </HBox>
                </VBox>

                <HBox
                    id="metricsGrid"
                    class="metricGrid"
                    wrap="Wrap"
                    visible="{= !${ui>/personsEmpty} }"
                >
                    <VBox class="metricCard incomeMetric">
                        <HBox
                            justifyContent="SpaceBetween"
                            alignItems="Start"
                        >
                            <Text
                                text="{i18n>metricIncomeLabel}"
                                class="metricLabel"
                            />
                            <core:Icon src="sap-icon://trend-up" />
                        </HBox>
                        <ObjectNumber
                            number="{
                                parts: [
                                    { path: 'Income' },
                                    { path: 'Currency_code' }
                                ],
                                formatter: 'formatter.formatCardAmount'
                            }"
                            class="metricNumber"
                        />
                        <Text
                            text="{i18n>metricIncomeHint}"
                            class="metricHint"
                        />
                    </VBox>
                    <VBox class="metricCard expenseMetric">
                        <HBox
                            justifyContent="SpaceBetween"
                            alignItems="Start"
                        >
                            <Text
                                text="{i18n>metricExpensesLabel}"
                                class="metricLabel"
                            />
                            <core:Icon src="sap-icon://cart" />
                        </HBox>
                        <ObjectNumber
                            number="{ui>/summary/expenses}"
                            state="{ path: 'MonthCriticallity', formatter: 'formatter.criticalityState' }"
                            class="metricNumber"
                        />
                        <Text
                            text="{ui>/summary/expenseHint}"
                            class="metricHint"
                        />
                    </VBox>
                    <VBox class="metricCard saveMetric">
                        <HBox
                            justifyContent="SpaceBetween"
                            alignItems="Start"
                        >
                            <Text
                                text="{i18n>metricSavingsLabel}"
                                class="metricLabel"
                            />
                            <core:Icon src="sap-icon://savings" />
                        </HBox>
                        <ObjectNumber
                            number="{ui>/summary/savings}"
                            class="metricNumber"
                        />
                        <Text
                            text="{i18n>metricSavingsHint}"
                            class="metricHint"
                        />
                    </VBox>
                    <VBox class="metricCard targetMetric">
                        <HBox
                            justifyContent="SpaceBetween"
                            alignItems="Start"
                        >
                            <Text
                                text="{i18n>metricTargetLabel}"
                                class="metricLabel"
                            />
                            <core:Icon src="sap-icon://target" />
                        </HBox>
                        <ObjectNumber
                            number="{
                                parts: [
                                    { path: 'ExpenseTarget' },
                                    { path: 'Currency_code' }
                                ],
                                formatter: 'formatter.formatCardAmount'
                            }"
                            class="metricNumber"
                        />
                        <Text
                            text="{i18n>metricTargetHint}"
                            class="metricHint"
                        />
                    </VBox>
                    <VBox class="metricCard paidMetric">
                        <HBox
                            justifyContent="SpaceBetween"
                            alignItems="Start"
                        >
                            <Text
                                text="{i18n>metricTotalPaidLabel}"
                                class="metricLabel"
                            />
                            <core:Icon src="sap-icon://money-bills" />
                        </HBox>
                        <ObjectNumber
                            number="{
                                parts: [
                                    { path: 'TotalExpensesPayed' },
                                    { path: 'Currency_code' }
                                ],
                                formatter: 'formatter.formatCardAmount'
                            }"
                            class="metricNumber"
                        />
                        <Text
                            text="{i18n>metricTotalPaidHint}"
                            class="metricHint"
                        />
                    </VBox>
                    <VBox class="metricCard payMetric">
                        <HBox
                            justifyContent="SpaceBetween"
                            alignItems="Start"
                        >
                            <Text
                                text="{i18n>metricTotalToPayLabel}"
                                class="metricLabel"
                            />
                            <core:Icon src="sap-icon://money-bills" />
                        </HBox>
                        <ObjectNumber
                            number="{
                                parts: [
                                    { path: 'TotalExpensesToPay' },
                                    { path: 'Currency_code' }
                                ],
                                formatter: 'formatter.formatCardAmount'
                            }"
                            state="{ path: 'CriticallityToPay', formatter: 'formatter.criticalityState' }"
                            class="metricNumber"
                        />
                        <Text
                            text="{i18n>metricTotalToPayHint}"
                            class="metricHint"
                        />
                    </VBox>
                    <VBox class="metricCard closedMetric">
                        <HBox
                            justifyContent="SpaceBetween"
                            alignItems="Start"
                        >
                            <Text
                                text="{i18n>metricTotalClosedLabel}"
                                class="metricLabel"
                            />
                            <core:Icon src="sap-icon://locked" />
                        </HBox>
                        <ObjectNumber
                            number="{
                                parts: [
                                    { path: 'TotalExpensesClosed' },
                                    { path: 'Currency_code' }
                                ],
                                formatter: 'formatter.formatCardAmount'
                            }"
                            class="metricNumber"
                        />
                        <Text
                            text="{i18n>metricTotalClosedHint}"
                            class="metricHint"
                        />
                    </VBox>
                    <VBox class="metricCard totalMetric">
                        <HBox
                            justifyContent="SpaceBetween"
                            alignItems="Start"
                        >
                            <Text
                                text="{i18n>metricTotalExpensesLabel}"
                                class="metricLabel"
                            />
                            <core:Icon src="sap-icon://request-quote" />
                        </HBox>
                        <ObjectNumber
                            number="{
                                parts: [
                                    { path: 'TotalExpenses' },
                                    { path: 'Currency_code' }
                                ],
                                formatter: 'formatter.formatCardAmount'
                            }"
                            class="metricNumber"
                        />
                        <Text
                            text="{i18n>metricTotalExpensesHint}"
                            class="metricHint"
                        />
                    </VBox>
                </HBox>

                <HBox
                    class="dashboardGrid"
                    wrap="Wrap"
                    visible="{= !${ui>/personsEmpty} }"
                >
                    <VBox class="surfaceCard transactionsPanel">
                        <HBox
                            justifyContent="SpaceBetween"
                            alignItems="Center"
                            class="sectionHeader"
                        >
                            <VBox>
                                <Title
                                    text="{i18n>recentTransactionsTitle}"
                                    level="H3"
                                />
                                <Text
                                    text="{i18n>recentTransactionsHint}"
                                    class="sectionHint"
                                />
                            </VBox>
                            <Button
                                icon="sap-icon://add"
                                type="Transparent"
                                press=".onOpenExpenseDialog"
                                tooltip="{i18n>expenseAddButton}"
                            />
                        </HBox>
                        <List
                            id="transactionsList"
                            items="{ path: 'ui>/transactions' }"
                            showSeparators="None"
                            class="transactionList"
                            noDataText="{i18n>transactionsNoData}"
                        >
                            <CustomListItem>
                                <HBox
                                    width="100%"
                                    alignItems="Center"
                                    justifyContent="SpaceBetween"
                                    class="transactionItem"
                                >
                                    <HBox alignItems="Center">
                                        <VBox class="transactionIcon">
                                            <!-- <core:Icon
                                                src="sap-icon://receipt"
                                            /> -->
                                            <Avatar
                                                src="{ui>Category/ImageBase64}"
                                                initials="{ path: 'ui>Category/Name', formatter: 'formatter.initials' }"
                                                displaySize="XS"
                                                displayShape="Circle"
                                            />
                                        </VBox>
                                        <VBox>
                                            <Text
                                                text="{ui>Description}"
                                                class="transactionTitle"
                                            />
                                            <Text
                                                text="{ parts: [ { path: 'ui>Category/Name' }, { path: 'Date' } ], formatter: 'formatter.transactionSubtle' }"
                                                class="transactionDate"
                                            />
                                        </VBox>
                                    </HBox>
                                    <ObjectNumber
                                        number="{
                                            parts: [
                                                { path: 'ui>Amount' },
                                                { path: 'ui>Currency' }
                                            ],
                                            formatter: 'formatter.formatCurrency'
                                        }"
                                        class="transactionAmount"
                                    />
                                </HBox>
                            </CustomListItem>
                        </List>
                    </VBox>

                    <VBox class="surfaceCard categoriesPanel">
                        <HBox
                            justifyContent="SpaceBetween"
                            alignItems="Center"
                            class="sectionHeader"
                        >
                            <VBox>
                                <Title
                                    text="{i18n>categoriesTitle}"
                                    level="H3"
                                />
                                <Text
                                    text="{i18n>categoriesHint}"
                                    class="sectionHint"
                                />
                            </VBox>
                            <Button
                                icon="sap-icon://add"
                                type="Transparent"
                                press=".onOpenCategoryDialog"
                                tooltip="{i18n>categoryAddButton}"
                            />
                        </HBox>
                        <List
                            items="{ path: 'ui>/categories' }"
                            showSeparators="None"
                            class="categoryList"
                            noDataText="{i18n>categoriesNoData}"
                        >
                            <CustomListItem press=".onCategoryPress">
                                <HBox
                                    width="100%"
                                    alignItems="Center"
                                    justifyContent="SpaceBetween"
                                    class="categoryItem"
                                >
                                    <HBox
                                        alignItems="Center"
                                        class="categoryItemMain"
                                    >
                                        <Avatar
                                            src="{ui>CategoryImageBase64}"
                                            displaySize="Custom"
                                            customDisplaySize="2.75rem"
                                            displayShape="Circle"
                                            initials="{ui>Name}"
                                            class="categoryItemAvatar"
                                        />
                                        <VBox>
                                            <Text
                                                text="{ui>Name}"
                                                class="transactionTitle"
                                            />
                                            <ProgressIndicator
                                                percentValue="{ui>Percent}"
                                                displayValue="{ui>Percent}%"
                                                state="None"
                                                width="12rem"
                                                class="categoryProgress"
                                            />
                                        </VBox>
                                    </HBox>
                                    <ObjectNumber
                                        number="{
                                            parts: [
                                                { path: 'ui>Total' },
                                                { path: 'ui>CurrencyCode' }
                                            ],
                                            formatter: 'formatter.formatCurrency'
                                        }"
                                        class="transactionAmount"
                                    />
                                </HBox>
                            </CustomListItem>
                        </List>
                    </VBox>

                    <VBox class="surfaceCard cardsPanel">
                        <HBox
                            justifyContent="SpaceBetween"
                            alignItems="Center"
                            class="sectionHeader"
                        >
                            <VBox>
                                <Title
                                    text="{i18n>cardsTitle}"
                                    level="H3"
                                />
                                <Text
                                    text="{i18n>cardsHint}"
                                    class="sectionHint"
                                />
                            </VBox>
                            <Button
                                icon="sap-icon://add"
                                type="Transparent"
                                press=".onOpenCardDialog"
                                tooltip="{i18n>cardDialogTitle}"
                            />
                        </HBox>
                        <VBox id="cardsList">
                            <List
                                id="cardsListItems"
                                items="{ path: 'Cards' }"
                                showSeparators="None"
                                class="cardList"
                                noDataText="{i18n>cardsNoData}"
                            >
                                <CustomListItem>
                                    <VBox class="creditCardItem">
                                        <HBox
                                            justifyContent="SpaceBetween"
                                            alignItems="Center"
                                        >
                                            <Text
                                                text="{Name}"
                                                class="creditCardName"
                                            />
                                            <Avatar
                                                src="{ parts: [ { path: 'ID' }, { path: 'ui>/cardImages' } ], formatter: 'formatter.cardImageValue' }"
                                                displaySize="XS"
                                                customDisplaySize="2.75rem"
                                                displayShape="Circle"
                                                initials="{Name}"
                                            />
                                        </HBox>
                                        <Text
                                            text="{i18n>cardLimitLabel}"
                                            class="creditCardLabel"
                                        />
                                        <ObjectNumber
                                            number="{
                                            parts: [
                                                { path: 'Limit' },
                                                { path: 'Currency_code' }
                                            ],
                                            formatter: 'formatter.formatCardAmount'
                                        }"
                                            class="creditCardValue"
                                        />
                                        <HBox justifyContent="SpaceBetween">
                                            <Text
                                                text="{ parts: [ { path: 'i18n>cardClosingDay' }, { path: 'ClosingDay' } ], formatter: 'formatter.formatTemplate' }"
                                                class="creditCardFoot"
                                            />
                                            <Text
                                                text="{ parts: [ { path: 'i18n>cardDueDay' }, { path: 'DueDay' } ], formatter: 'formatter.formatTemplate' }"
                                                class="creditCardFoot"
                                            />
                                        </HBox>
                                    </VBox>
                                </CustomListItem>
                            </List>
                        </VBox>
                    </VBox>
                </HBox>
            </VBox>
        </content>
    </Page>
</mvc:View>
