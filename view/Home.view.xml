<mvc:View
    controllerName="apps.dflc.expensemanager.controller.Home"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    core:require="{
        formatter: 'apps/dflc/expensemanager/util/format'
    }"
>
    <Page
        id="homePage"
        showHeader="false"
        enableScrolling="true"
        showFooter="{= ${ui>/selectedPersonDraft} &amp;&amp; !${ui>/personsEmpty} }"
        floatingFooter="true"
        class="financePage"
        busy="{ui>/busy}"
    >
        <content>
            <!-- Header fixo (sticky no topo da rolagem): ícone do app, pessoa
                 selecionada e tema sempre à mão, sem o conteúdo passar por
                 baixo da barra de status no PWA em tela cheia. -->
            <HBox class="appHeader">
                <HBox
                    class="appHeaderInner"
                    justifyContent="SpaceBetween"
                    alignItems="Center"
                >
                    <Image
                        src="img/logo.svg"
                        width="2.25rem"
                        height="2.25rem"
                        decorative="true"
                        class="brandLogo"
                    />
                    <HBox
                        alignItems="Center"
                        justifyContent="End"
                        class="appHeaderActions"
                    >
                        <HBox
                            alignItems="Center"
                            class="personPicker"
                            visible="{= !${ui>/personsEmpty} }"
                        >
                            <Avatar
                                id="personImage"
                                src="{ui>/selectedPersonImage}"
                                initials="{
                                    path: 'ui>/selectedPerson/Name',
                                    formatter: 'formatter.initials'
                                }"
                                displaySize="XS"
                                displayShape="Circle"
                                class="personAvatar"
                            />
                            <Select
                                id="personSelect"
                                items="{
                                    path: '/Persons',
                                    parameters: {
                                        $select: 'ID,Name,Income,ExpenseTarget,Currency,ImageType,IsActiveEntity,HasDraftEntity',
                                        $expand: 'DraftAdministrativeData($select=DraftUUID,InProcessByUser)',
                                        $filter: '(IsActiveEntity eq false or SiblingEntity/IsActiveEntity eq null)'
                                    }
                                }"
                                selectedKey="{ui>/selectedPersonId}"
                                change=".onPersonChange"
                                class="personSelect"
                                tooltip="{i18n>personManageLabel}"
                            >
                                <core:Item
                                    key="{ID}"
                                    text="{= ${Name} + (${path: 'IsActiveEntity', targetType: 'any'} === false ? ' ' + ${i18n>personDraftSuffix} : (${path: 'HasDraftEntity', targetType: 'any'} === true ? ' ' + ${i18n>personLockedSuffix} : '')) }"
                                />
                            </Select>
                        </HBox>
                        <Button
                            icon="sap-icon://download"
                            type="Transparent"
                            tooltip="{i18n>installAppTooltip}"
                            press=".onInstallApp"
                            visible="{pwa>/canInstall}"
                            class="iconAction"
                        />
                        <Button
                            id="themeToggle"
                            icon="sap-icon://light-mode"
                            type="Transparent"
                            tooltip="{i18n>themeDarkTooltip}"
                            press=".onToggleTheme"
                            class="iconAction"
                        />
                    </HBox>
                </HBox>
            </HBox>
            <VBox class="financeShell">
                <VBox id="personSection">
                    <HBox
                        class="topBar"
                        justifyContent="SpaceBetween"
                        alignItems="Center"
                        wrap="Wrap"
                    >
                        <VBox>
                            <Title
                                text="{i18n>brandTitle}"
                                level="H2"
                                class="brandTitle"
                            />
                            <Text
                                text="{ui>/monthLabel}"
                                class="brandCaption"
                            />
                        </VBox>
                        <HBox
                            alignItems="Center"
                            justifyContent="End"
                            class="topActions actionButtonsGroup"
                        >
                            <Button
                                icon="sap-icon://share-2"
                                type="Transparent"
                                tooltip="{i18n>sharesTooltip}"
                                press=".onOpenSharesDialog"
                                class="iconAction"
                                visible="{= !${ui>/personsEmpty} }"
                            />
                            <Button
                                icon="sap-icon://show"
                                type="Transparent"
                                tooltip="{i18n>personEditTooltip}"
                                press=".onOpenPersonDetailDialog"
                                class="iconAction"
                                visible="{= !${ui>/personsEmpty} }"
                            />
                            <Button
                                icon="sap-icon://delete"
                                type="Transparent"
                                tooltip="{i18n>personDeleteButton}"
                                press=".onDeletePerson"
                                class="iconAction"
                                visible="{= !${ui>/personsEmpty} }"
                            />
                            <Button
                                icon="sap-icon://add"
                                type="Transparent"
                                tooltip="{i18n>personAddButton}"
                                press=".onOpenPersonDialog"
                                class="iconAction"
                                visible="{= !${ui>/personsEmpty} }"
                            />
                            <Button
                                icon="sap-icon://log"
                                type="Transparent"
                                tooltip="{i18n>logoutTooltip}"
                                press=".onLogout"
                                class="iconAction"
                            />
                        </HBox>
                    </HBox>
                        <MessageStrip
                            text="{parts: ['i18n>personDraftInfo', 'ui>/selectedPersonDraftChangedAt'], formatter: '.formatMessage'}"
                            type="Information"
                            showIcon="true"
                            visible="{= ${ui>/selectedPersonDraft} &amp;&amp; !${ui>/personsEmpty} }"
                            class="sapUiSmallMarginBottom personDraftStrip"
                        />
                        <MessageStrip
                            text="{parts: ['i18n>personLockedInfo', 'ui>/selectedPersonLockedBy', 'ui>/selectedPersonLockedAt'], formatter: '.formatMessage'}"
                            type="Warning"
                            showIcon="true"
                            visible="{= !!${ui>/selectedPersonLockedBy} &amp;&amp; !${ui>/personsEmpty} }"
                            class="sapUiSmallMarginBottom personDraftStrip"
                        />
                        <MessageStrip
                            text="{parts: ['i18n>personAbandonedInfo', 'ui>/selectedPersonAbandonedBy', 'ui>/selectedPersonLockedAt'], formatter: '.formatMessage'}"
                            type="Warning"
                            showIcon="true"
                            visible="{= !!${ui>/selectedPersonAbandonedBy} &amp;&amp; !${ui>/personsEmpty} }"
                            class="sapUiSmallMarginBottom personDraftStrip"
                        />
                </VBox>
                <VBox
                    class="emptyState"
                    visible="{ui>/personsEmpty}"
                    alignItems="Center"
                    justifyContent="Center"
                >
                    <core:Icon
                        src="sap-icon://inbox"
                        class="emptyStateIcon"
                    />
                    <Title
                        text="{i18n>emptyPersonsTitle}"
                        level="H2"
                        class="emptyStateTitle"
                    />
                    <Text
                        text="{i18n>emptyPersonsText}"
                        class="emptyStateText"
                    />
                    <HBox
                        wrap="Wrap"
                        alignItems="Center"
                        justifyContent="Center"
                    >
                        <Button
                            text="{i18n>personAddButton}"
                            icon="sap-icon://add"
                            type="Emphasized"
                            press=".onOpenPersonDialog"
                            class="emptyStateButton"
                        />
                        <Button
                            text="{i18n>backupRestoreButton}"
                            icon="sap-icon://upload-to-cloud"
                            type="Transparent"
                            press=".onRestoreBackup"
                            class="emptyStateButton"
                        />
                    </HBox>
                </VBox>
                <IconTabBar
                    id="sectionTabs"
                    selectedKey="{ui>/tab}"
                    select=".onTabSelect"
                    headerMode="Inline"
                    expandable="false"
                    applyContentPadding="false"
                    backgroundDesign="Transparent"
                    visible="{= !${ui>/personsEmpty} }"
                    class="sectionTabs"
                >
                    <items>
                        <IconTabFilter key="Home" icon="sap-icon://home" text="{i18n>tabOverview}" />
                        <IconTabFilter key="Cards" icon="sap-icon://credit-card" text="{i18n>tabCards}" />
                        <IconTabFilter key="Categories" icon="sap-icon://tag" text="{i18n>tabCategories}" />
                        <IconTabFilter key="Invoices" icon="sap-icon://receipt" text="{i18n>tabInvoices}" />
                        <IconTabFilter key="Liabilities" icon="sap-icon://loan" text="{i18n>tabLiabilities}" />
                        <IconTabFilter key="Shares" icon="sap-icon://share-2" text="{i18n>tabShares}" />
                    </items>
                </IconTabBar>
                <VBox id="tabContent" class="tabContent" visible="{= !${ui>/personsEmpty} }" />
            </VBox>
        </content>
        <footer>
            <OverflowToolbar class="personDraftFooter">
                <ToolbarSpacer />
                <Button text="{i18n>personDiscardButton}" type="Reject" press=".onDiscardPersonDraft" />
                <Button text="{i18n>personSaveDraftButton}" type="Emphasized" icon="sap-icon://save" press=".onSavePersonDraft" />
            </OverflowToolbar>
        </footer>
    </Page>
</mvc:View>
