<mvc:View
    controllerName="apps.dflc.expensemanager.controller.Cards"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns:core="sap.ui.core"
    xmlns="sap.m"
    xmlns:u="sap.ui.unified"
    core:require="{
        formatter: 'apps/dflc/expensemanager/util/format'
    }"
>
    <VBox id="cardsPage" class="surfaceCard tabPage" busy="{ui>/busy}">
        <HBox justifyContent="SpaceBetween" alignItems="Center" wrap="Wrap" class="sectionHeader">
            <VBox>
                <Title text="{i18n>cardsDialogTitle}" level="H3" />
                <Text text="{i18n>cardsTabIntro}" class="sectionHint" />
            </VBox>
            <Button
                text="{i18n>cardsEditTooltip}"
                icon="sap-icon://edit"
                type="Emphasized"
                press=".onToggleCardsEdit"
                visible="{= !${ui>/selectedPersonDraft} }"
            />
        </HBox>
        <VBox class="cardManagerAddRow sapUiSmallMarginBottom">
            <Label
                text="{i18n>cardsAddLabel}"
                labelFor="newCardName"
                class="cardManagerAddTitle"
            />
            <HBox wrap="Wrap" alignItems="End" class="sapUiTinyMarginTop">
                <VBox class="sapUiTinyMarginEnd sapUiTinyMarginBottom">
                    <Label text="{i18n>cardNameLabel}" labelFor="newCardName" />
                    <Input
                        id="newCardName"
                        value="{ui>/newCard/name}"
                        placeholder="{i18n>cardNamePlaceholder}"
                        width="100%"
                    >
                        <layoutData>
                            <FlexItemData minWidth="12rem" maxWidth="15rem" growFactor="1" />
                        </layoutData>
                    </Input>
                </VBox>
                <VBox class="sapUiTinyMarginEnd sapUiTinyMarginBottom">
                    <Label text="{i18n>cardLimitLabel}" labelFor="newCardLimit" />
                    <Input
                        id="newCardLimit"
                        value="{ path: 'ui>/newCard/limit', type: 'apps/dflc/expensemanager/util/DecimalInput' }"
                        placeholder="{i18n>cardLimitPlaceholder}"
                        width="100%"
                    >
                        <layoutData>
                            <FlexItemData minWidth="6rem" maxWidth="7.5rem" />
                        </layoutData>
                    </Input>
                </VBox>
                <VBox class="sapUiTinyMarginEnd sapUiTinyMarginBottom">
                    <Label text="{i18n>cardCurrencyLabel}" labelFor="newCardCurrency" />
                    <Select
                        id="newCardCurrency"
                        selectedKey="{ui>/newCard/currency}"
                        width="100%"
                    >
                        <layoutData>
                            <FlexItemData minWidth="10rem" maxWidth="12rem" />
                        </layoutData>
                        <core:Item key="BRL" text="Real brasileiro (BRL)" />
                        <core:Item key="USD" text="Dólar americano (USD)" />
                    </Select>
                </VBox>
                <VBox class="sapUiTinyMarginEnd sapUiTinyMarginBottom">
                    <Label text="{i18n>cardsClosingLabel}" labelFor="newCardClosing" />
                    <Input
                        id="newCardClosing"
                        value="{ path: 'ui>/newCard/closingDay', type: 'apps/dflc/expensemanager/util/DecimalInput' }"
                        placeholder="{i18n>cardsDayPlaceholder}"
                        width="100%"
                    >
                        <layoutData>
                            <FlexItemData minWidth="4.5rem" maxWidth="5.5rem" />
                        </layoutData>
                    </Input>
                </VBox>
                <VBox class="sapUiTinyMarginEnd sapUiTinyMarginBottom">
                    <Label text="{i18n>cardsDueLabel}" labelFor="newCardDue" />
                    <Input
                        id="newCardDue"
                        value="{ path: 'ui>/newCard/dueDay', type: 'apps/dflc/expensemanager/util/DecimalInput' }"
                        placeholder="{i18n>cardsDayPlaceholder}"
                        width="100%"
                    >
                        <layoutData>
                            <FlexItemData minWidth="4.5rem" maxWidth="5.5rem" />
                        </layoutData>
                    </Input>
                </VBox>
                <Button
                    text="{i18n>cardsAddLabel}"
                    icon="sap-icon://add"
                    type="Emphasized"
                    press=".onAddCard"
                    class="sapUiTinyMarginBottom"
                />
            </HBox>
        </VBox>

        <List
            id="cardsList"
            items="{Cards}"
            mode="None"
            growing="true"
            noDataText="{i18n>cardsNoData}"
            class="shareList cardManagerList"
        >
            <CustomListItem class="cardManagerCard sapUiTinyMarginBottom">
                <VBox class="cardManagerBody">
                    <HBox
                        alignItems="Center"
                        class="cardManagerRow"
                    >
                        <Avatar
                            src="{ parts: [ { path: 'ID' }, { path: 'ui>/dialogCardImages' } ], formatter: 'formatter.cardImageValue' }"
                            displaySize="Custom"
                            customDisplaySize="2.75rem"
                            displayShape="Circle"
                            initials="{ parts: [ { path: 'Name' } ], formatter: 'formatter.initials' }"
                            class="cardManagerAvatar"
                        />
                        <Input
                            value="{Name}"
                            enabled="{ui>/selectedPersonDraft}"
                            placeholder="{i18n>cardNamePlaceholder}"
                            class="cardManagerInput"
                        >
                            <layoutData>
                                <FlexItemData growFactor="1" minWidth="8rem" />
                            </layoutData>
                        </Input>
                        <u:FileUploader
                            buttonOnly="true"
                            iconOnly="true"
                            icon="sap-icon://camera"
                            buttonType="Transparent"
                            tooltip="{i18n>cardsPhotoButton}"
                            fileType="png,jpg,jpeg"
                            uploadOnChange="false"
                            multiple="false"
                            sendXHR="true"
                            httpRequestMethod="PUT"
                            useMultipart="false"
                            change=".onCardPhotoChanged"
                            enabled="{ui>/selectedPersonDraft}"
                            class="cardManagerPhoto"
                        />
                        <Button
                            icon="sap-icon://edit"
                            type="Transparent"
                            tooltip="{i18n>cardsEditTooltip}"
                            press=".onToggleCardsEdit"
                            visible="{= !${ui>/selectedPersonDraft} }"
                        />
                        <Button
                            icon="sap-icon://delete"
                            type="Transparent"
                            tooltip="{i18n>cardsRemoveTooltip}"
                            press=".onRemoveCard"
                        />
                    </HBox>
                    <HBox
                        wrap="Wrap"
                        alignItems="End"
                        class="cardManagerFields"
                    >
                        <VBox class="sapUiTinyMarginEnd sapUiTinyMarginBottom">
                            <Label text="{i18n>cardLimitLabel}" />
                            <Input
                                value="{ path: 'Limit', type: 'apps/dflc/expensemanager/util/DecimalInput' }"
                                enabled="{ui>/selectedPersonDraft}"
                                width="100%"
                            >
                                <layoutData>
                                    <FlexItemData minWidth="6rem" maxWidth="7.5rem" />
                                </layoutData>
                            </Input>
                        </VBox>
                        <VBox class="sapUiTinyMarginEnd sapUiTinyMarginBottom">
                            <Label text="{i18n>cardCurrencyLabel}" />
                            <Select
                                selectedKey="{Currency_code}"
                                enabled="{ui>/selectedPersonDraft}"
                                forceSelection="false"
                                width="100%"
                            >
                                <layoutData>
                                    <FlexItemData minWidth="10rem" maxWidth="12rem" />
                                </layoutData>
                                <core:Item key="BRL" text="Real brasileiro (BRL)" />
                                <core:Item key="USD" text="Dólar americano (USD)" />
                            </Select>
                        </VBox>
                        <VBox class="sapUiTinyMarginEnd sapUiTinyMarginBottom">
                            <Label text="{i18n>cardsClosingLabel}" />
                            <Input
                                value="{ path: 'ClosingDay', type: 'apps/dflc/expensemanager/util/DecimalInput' }"
                                enabled="{ui>/selectedPersonDraft}"
                                width="100%"
                            >
                                <layoutData>
                                    <FlexItemData minWidth="4.5rem" maxWidth="5.5rem" />
                                </layoutData>
                            </Input>
                        </VBox>
                        <VBox class="sapUiTinyMarginEnd sapUiTinyMarginBottom">
                            <Label text="{i18n>cardsDueLabel}" />
                            <Input
                                value="{ path: 'DueDay', type: 'apps/dflc/expensemanager/util/DecimalInput' }"
                                enabled="{ui>/selectedPersonDraft}"
                                width="100%"
                            >
                                <layoutData>
                                    <FlexItemData minWidth="4.5rem" maxWidth="5.5rem" />
                                </layoutData>
                            </Input>
                        </VBox>
                    </HBox>
                </VBox>
            </CustomListItem>
        </List>
    </VBox>
</mvc:View>
