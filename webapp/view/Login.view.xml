<mvc:View
    controllerName="apps.dflc.expensemanager.controller.Login"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
>
    <Page id="loginPage" showHeader="false" backgroundDesign="List" class="loginPage">
        <content>
            <!-- No celular, o mesmo header da Home: em tela cheia ele continua
                 pela barra de status, na cor da marca. -->
            <HBox class="appHeader" visible="{device>/system/phone}">
                <HBox
                    class="appHeaderInner"
                    alignItems="Center"
                >
                    <Image
                        src="img/logo.svg"
                        width="2.25rem"
                        height="2.25rem"
                        decorative="true"
                        class="brandLogo sapUiSmallMarginEnd"
                    />
                    <Title
                        text="{i18n>brandTitle}"
                        level="H2"
                        class="appHeaderTitle"
                    />
                </HBox>
            </HBox>
            <HBox
                id="loginShell"
                class="loginShell"
                height="100%"
                alignItems="Stretch"
                wrap="NoWrap"
            >
                <VBox
                    class="loginHero"
                    alignItems="Start"
                    justifyContent="Center"
                >
                    <HBox alignItems="Center" class="loginHeroBrand sapUiMediumMarginBottom">
                        <Image
                            src="img/logo.svg"
                            width="2.6rem"
                            height="2.6rem"
                            decorative="true"
                            class="loginHeroLogo sapUiSmallMarginEnd"
                        />
                        <Title
                            text="{i18n>brandTitle}"
                            level="H2"
                            titleStyle="H2"
                            class="loginHeroTitle"
                        />
                    </HBox>

                    <Title
                        text="{i18n>loginHeadline}"
                        level="H1"
                        titleStyle="H1"
                        wrap="true"
                        class="loginHeroHeadline sapUiTinyMarginBottom"
                    />

                    <Text
                        text="{i18n>loginSubtitle}"
                        class="loginHeroSubtitle sapUiMediumMarginBottom"
                    />

                    <VBox class="loginFeatures">
                        <HBox alignItems="Center" class="loginFeatureItem">
                            <core:Icon
                                src="sap-icon://credit-card"
                                class="loginFeatureIcon sapUiSmallMarginEnd"
                            />
                            <Text text="{i18n>loginFeatureCards}" class="loginFeatureText" />
                        </HBox>

                        <HBox alignItems="Center" class="loginFeatureItem sapUiTinyMarginTop">
                            <core:Icon
                                src="sap-icon://information"
                                class="loginFeatureIcon sapUiSmallMarginEnd"
                            />
                            <Text text="{i18n>loginFeatureGoals}" class="loginFeatureText" />
                        </HBox>

                        <HBox alignItems="Center" class="loginFeatureItem sapUiTinyMarginTop">
                            <core:Icon
                                src="sap-icon://money-bills"
                                class="loginFeatureIcon sapUiSmallMarginEnd"
                            />
                            <Text text="{i18n>loginFeatureDebts}" class="loginFeatureText" />
                        </HBox>
                    </VBox>
                </VBox>

                <FlexBox
                    class="loginAside"
                    height="100%"
                    justifyContent="Center"
                    alignItems="Center"
                >
                    <VBox
                        id="loginCard"
                        class="loginCard"
                        alignItems="Center"
                        busy="{login>/busy}"
                        busyIndicatorDelay="0"
                    >
                        <!-- No celular o header já mostra o logo e o nome. -->
                        <HBox
                            alignItems="Center"
                            class="loginBrand sapUiMediumMarginBottom"
                            visible="{= !${device>/system/phone} }"
                        >
                            <Image
                                src="img/logo.svg"
                                width="2.4rem"
                                height="2.4rem"
                                decorative="true"
                                class="loginBrandLogo sapUiSmallMarginEnd"
                            />
                            <Title
                                text="{i18n>brandTitle}"
                                level="H2"
                                titleStyle="H2"
                                class="loginBrandTitle"
                            />
                        </HBox>

                        <Title
                            text="{i18n>loginHeadline}"
                            level="H1"
                            titleStyle="H3"
                            wrap="true"
                            textAlign="Center"
                            class="loginHeadline sapUiTinyMarginBottom"
                        />

                        <Text
                            text="{i18n>loginSubtitle}"
                            textAlign="Center"
                            class="loginSubtitle sapUiMediumMarginBottom"
                        />

                        <VBox width="100%" class="loginForm">
                            <MessageStrip
                                text="{login>/error}"
                                type="Error"
                                showIcon="true"
                                visible="{= !!${login>/error} }"
                                class="loginMessage"
                            />
                            <Label text="{i18n>loginEmail}" labelFor="loginEmail" required="true" />
                            <Input
                                id="loginEmail"
                                value="{login>/email}"
                                type="Email"
                                placeholder="{i18n>loginEmailPlaceholder}"
                                valueState="{login>/emailState}"
                                valueStateText="{i18n>loginEmailRequired}"
                                maxLength="256"
                                submit=".onPasswordLogin"
                                width="100%"
                            />
                            <Label text="{i18n>loginPassword}" labelFor="loginPassword" required="true" class="loginLabel" />
                            <Input
                                id="loginPassword"
                                value="{login>/password}"
                                type="{= ${login>/showPassword} ? 'Text' : 'Password' }"
                                placeholder="{i18n>loginPasswordPlaceholder}"
                                valueState="{login>/passwordState}"
                                valueStateText="{i18n>loginPasswordRequired}"
                                showValueHelp="true"
                                valueHelpIconSrc="{= ${login>/showPassword} ? 'sap-icon://hide' : 'sap-icon://show' }"
                                valueHelpRequest=".onTogglePassword"
                                maxLength="256"
                                submit=".onPasswordLogin"
                                width="100%"
                            />
                            <Button
                                id="loginButton"
                                text="{i18n>loginButton}"
                                icon="sap-icon://log"
                                press=".onPasswordLogin"
                                type="Emphasized"
                                width="100%"
                                class="loginPrimary"
                            />
                        </VBox>

                        <Text text="{i18n>loginOr}" textAlign="Center" class="loginDivider" />

                        <Link text="{i18n>loginWithSap}" press=".onLogin" class="loginSap" />

                        <Text
                            text="{i18n>loginNote}"
                            textAlign="Center"
                            class="loginNote sapUiTinyMarginBottom"
                        />

                        <!-- Só no navegador; some quando o app já está instalado. -->
                        <Button
                            text="{i18n>installAppButton}"
                            icon="sap-icon://download"
                            type="Transparent"
                            width="100%"
                            press=".onInstallApp"
                            visible="{pwa>/canInstall}"
                            class="loginInstall"
                        />
                    </VBox>
                </FlexBox>
            </HBox>
        </content>
    </Page>
</mvc:View>
