<mvc:View
    controllerName="apps.dflc.expensemanager.controller.Login"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
>
    <Page id="loginPage" showHeader="false" class="loginPage">
        <content>
            <VBox
                id="loginShell"
                class="loginShell"
                justifyContent="Center"
                alignItems="Center"
            >
                <VBox id="loginCard" class="loginCard">
                    <HBox alignItems="Center" class="loginBrand">
                        <core:Icon src="sap-icon://wallet" class="loginBrandIcon" />
                        <Title text="{i18n>brandTitle}" level="H2" class="loginBrandTitle" />
                    </HBox>

                    <Title text="{i18n>loginHeadline}" level="H1" class="loginHeadline" />

                    <Text text="{i18n>loginSubtitle}" class="loginSubtitle" />

                    <Button
                        id="loginButton"
                        text="{i18n>loginButton}"
                        icon="sap-icon://log"
                        press=".onLogin"
                        type="Emphasized"
                        class="loginPrimary"
                    />

                    <Text text="{i18n>loginNote}" class="loginNote" />
                </VBox>
            </VBox>
        </content>
    </Page>
</mvc:View>
