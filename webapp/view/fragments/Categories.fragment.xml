<core:FragmentDefinition
    xmlns:core="sap.ui.core"
    xmlns="sap.m"
    xmlns:u="sap.ui.unified"
    xmlns:layout="sap.ui.layout"
    id="Categories"
    core:require="{
        formatter: 'apps/dflc/expensemanager/util/format',
        handler: 'apps/dflc/expensemanager/controller/fragments/Categories'
    }"
>
    <Dialog
        id="categoriesDialog"
        title="{i18n>categoriesDialogTitle}"
        class="financeDialog"
        contentWidth="36rem"
        stretch="{device>/system/phone}"
        beforeOpen="handler.onDialogBeforeOpen"
        afterOpen="handler.onDialogAfterOpen"
        afterClose="handler.onDialogAfterClose"
        busy="{ui>/busy}"
    >
        <content>
            <VBox class="sapUiSmallMargin dialogContent">
                <MessageStrip
                    text="{i18n>categoriesDialogIntro}"
                    type="Information"
                    showIcon="true"
                    class="sapUiSmallMarginBottom"
                />

                <VBox class="categoryManagerAddRow sapUiSmallMarginBottom">
                    <Label
                        text="{i18n>categoriesAddLabel}"
                        labelFor="newCategoryName"
                        class="categoryManagerAddTitle"
                    />
                    <HBox wrap="Wrap" alignItems="Center">
                        <Input
                            id="newCategoryName"
                            value="{ui>/newCategory/name}"
                            placeholder="{i18n>categoryNamePlaceholder}"
                            maxLength="20"
                            class="sapUiTinyMarginEnd sapUiTinyMarginBottom"
                            width="100%"
                        >
                            <layoutData>
                                <FlexItemData minWidth="15rem" maxWidth="24rem" growFactor="1" />
                            </layoutData>
                        </Input>
                        <Button
                            text="{i18n>categoriesAddLabel}"
                            icon="sap-icon://add"
                            type="Emphasized"
                            press="handler.onAddCategory"
                            class="sapUiTinyMarginBottom"
                        />
                    </HBox>
                </VBox>

                <List
                    id="categoriesList"
                    items="{Categories}"
                    mode="None"
                    growing="true"
                    noDataText="{i18n>categoriesNoData}"
                    class="shareList categoryManagerList"
                >
                    <CustomListItem class="categoryManagerCard sapUiTinyMarginBottom">
                        <HBox
                            alignItems="Center"
                            class="categoryManagerRow"
                        >
                            <Avatar
                                src="{ parts: [ { path: 'ID' }, { path: 'ui>/dialogCategoryImages' } ], formatter: 'formatter.cardImageValue' }"
                                displaySize="Custom"
                                customDisplaySize="2.75rem"
                                displayShape="Circle"
                                initials="{ parts: [ { path: 'Name' } ], formatter: 'formatter.initials' }"
                                class="categoryManagerAvatar"
                            />
                            <Input
                                value="{Name}"
                                placeholder="{i18n>categoryNamePlaceholder}"
                                maxLength="20"
                                class="categoryManagerInput"
                            >
                                <layoutData>
                                    <FlexItemData growFactor="1" minWidth="8rem" />
                                </layoutData>
                            </Input>
                            <u:FileUploader
                                buttonOnly="true"
                                iconOnly="true"
                                icon="sap-icon://camera"
                                buttonType="Transparent"
                                tooltip="{i18n>categoriesPhotoButton}"
                                fileType="png,jpg,jpeg"
                                uploadOnChange="false"
                                multiple="false"
                                change="handler.onCategoryPhotoChanged"
                                class="categoryManagerPhoto"
                            />
                            <Button
                                icon="sap-icon://delete"
                                type="Transparent"
                                tooltip="{i18n>categoriesRemoveTooltip}"
                                press="handler.onRemoveCategory"
                            />
                        </HBox>
                    </CustomListItem>
                </List>
            </VBox>
        </content>
        <buttons>
            <Button
                text="{i18n>categoriesSaveButton}"
                icon="sap-icon://save"
                type="Emphasized"
                press="handler.onSaveCategories"
            />
            <Button
                text="{i18n>categoriesCancelButton}"
                icon="sap-icon://cancel"
                press="handler.onCancelCategories"
            />
            <Button
                text="{i18n>categoriesDiscardButton}"
                type="Transparent"
                press="handler.onDiscardCategories"
            />
        </buttons>
    </Dialog>
</core:FragmentDefinition>