<core:FragmentDefinition
    xmlns:core="sap.ui.core"
    xmlns="sap.m"
    xmlns:f="sap.f"
    xmlns:l="sap.ui.layout"
    id="Liabilities"
    core:require="{
        formatter: 'apps/dflc/expensemanager/util/format',
        handler: 'apps/dflc/expensemanager/controller/fragments/Liabilities'
    }"
>
    <Dialog
        id="liabilitiesDialog"
        title="{i18n>liabilitiesDialogTitle}"
        class="financeDialog"
        contentWidth="54rem"
        stretch="{device>/system/phone}"
        beforeOpen="handler.onDialogBeforeOpen"
        afterOpen="handler.onDialogAfterOpen"
        afterClose="handler.onDialogAfterClose"
        busy="{ui>/busy}"
    >
        <content>
            <VBox class="sapUiSmallMargin">
                <MessageStrip
                    text="{i18n>liabilitiesDialogIntro}"
                    type="Information"
                    showIcon="true"
                    class="sapUiSmallMarginBottom"
                />

                <VBox class="cardManagerAddRow sapUiSmallMarginBottom">
                    <Label
                        text="{i18n>liabilitiesAddLabel}"
                        labelFor="newLiabilityName"
                        class="cardManagerAddTitle"
                    />
                    <HBox wrap="Wrap" alignItems="End" class="sapUiTinyMarginTop">
                        <VBox class="sapUiTinyMarginEnd sapUiTinyMarginBottom">
                            <Label text="{i18n>liabilitiesNameLabel}" labelFor="newLiabilityName" />
                            <Input
                                id="newLiabilityName"
                                value="{ui>/newLiability/name}"
                                placeholder="{i18n>liabilitiesNamePlaceholder}"
                                width="100%"
                            >
                                <layoutData>
                                    <FlexItemData minWidth="12rem" maxWidth="16rem" growFactor="1" />
                                </layoutData>
                            </Input>
                        </VBox>
                        <VBox class="sapUiTinyMarginEnd sapUiTinyMarginBottom">
                            <Label text="{i18n>liabilitiesCreditorLabel}" labelFor="newLiabilityCreditor" />
                            <Input
                                id="newLiabilityCreditor"
                                value="{ui>/newLiability/creditor}"
                                placeholder="{i18n>liabilitiesCreditorPlaceholder}"
                                width="100%"
                            >
                                <layoutData>
                                    <FlexItemData minWidth="9rem" maxWidth="13rem" growFactor="1" />
                                </layoutData>
                            </Input>
                        </VBox>
                        <VBox class="sapUiTinyMarginEnd sapUiTinyMarginBottom">
                            <Label text="{i18n>liabilitiesOriginalAmountLabel}" labelFor="newLiabilityOriginalAmount" />
                            <Input
                                id="newLiabilityOriginalAmount"
                                value="{ui>/newLiability/originalAmount}"
                                type="Number"
                                width="100%"
                            >
                                <layoutData>
                                    <FlexItemData minWidth="6.5rem" maxWidth="8rem" />
                                </layoutData>
                            </Input>
                        </VBox>
                        <VBox class="sapUiTinyMarginEnd sapUiTinyMarginBottom">
                            <Label text="{i18n>liabilitiesCurrencyLabel}" labelFor="newLiabilityCurrency" />
                            <Select
                                id="newLiabilityCurrency"
                                selectedKey="{ui>/newLiability/currency}"
                                width="100%"
                            >
                                <layoutData>
                                    <FlexItemData minWidth="8rem" maxWidth="10rem" />
                                </layoutData>
                                <core:Item key="BRL" text="BRL" />
                                <core:Item key="USD" text="USD" />
                            </Select>
                        </VBox>
                        <VBox class="sapUiTinyMarginEnd sapUiTinyMarginBottom">
                            <Label text="{i18n>liabilitiesTypeLabel}" labelFor="newLiabilityType" />
                            <Select
                                id="newLiabilityType"
                                selectedKey="{ui>/newLiability/type}"
                                items="{ui>/liabilityTypeOptions}"
                                width="100%"
                            >
                                <layoutData>
                                    <FlexItemData minWidth="11rem" maxWidth="14rem" />
                                </layoutData>
                                <core:Item key="{ui>key}" text="{ui>text}" />
                            </Select>
                        </VBox>
                        <VBox class="sapUiTinyMarginEnd sapUiTinyMarginBottom">
                            <Label text="{i18n>liabilitiesInterestModeLabel}" labelFor="newLiabilityInterestMode" />
                            <Select
                                id="newLiabilityInterestMode"
                                selectedKey="{ui>/newLiability/interestMode}"
                                items="{ui>/liabilityInterestModeOptions}"
                                width="100%"
                            >
                                <layoutData>
                                    <FlexItemData minWidth="8rem" maxWidth="10rem" />
                                </layoutData>
                                <core:Item key="{ui>key}" text="{ui>text}" />
                            </Select>
                        </VBox>
                        <VBox class="sapUiTinyMarginEnd sapUiTinyMarginBottom">
                            <Label text="{i18n>liabilitiesInterestRateLabel}" labelFor="newLiabilityInterestRate" />
                            <Input
                                id="newLiabilityInterestRate"
                                value="{ui>/newLiability/interestRate}"
                                type="Number"
                                width="100%"
                            >
                                <layoutData>
                                    <FlexItemData minWidth="5.5rem" maxWidth="7rem" />
                                </layoutData>
                            </Input>
                        </VBox>
                        <VBox class="sapUiTinyMarginEnd sapUiTinyMarginBottom">
                            <Label text="{i18n>liabilitiesInstallmentsLabel}" labelFor="newLiabilityInstallments" />
                            <Input
                                id="newLiabilityInstallments"
                                value="{ui>/newLiability/installments}"
                                type="Number"
                                width="100%"
                            >
                                <layoutData>
                                    <FlexItemData minWidth="5rem" maxWidth="6rem" />
                                </layoutData>
                            </Input>
                        </VBox>
                        <VBox class="sapUiTinyMarginEnd sapUiTinyMarginBottom">
                            <Label text="{i18n>liabilitiesStartDateLabel}" labelFor="newLiabilityStartDate" />
                            <DatePicker
                                id="newLiabilityStartDate"
                                value="{ui>/newLiability/startDate}"
                                width="100%"
                            >
                                <layoutData>
                                    <FlexItemData minWidth="8rem" maxWidth="10rem" />
                                </layoutData>
                            </DatePicker>
                        </VBox>
                        <VBox class="sapUiTinyMarginEnd sapUiTinyMarginBottom">
                            <Label text="{i18n>liabilitiesFirstDueDateLabel}" labelFor="newLiabilityFirstDueDate" />
                            <DatePicker
                                id="newLiabilityFirstDueDate"
                                value="{ui>/newLiability/firstDueDate}"
                                width="100%"
                            >
                                <layoutData>
                                    <FlexItemData minWidth="8rem" maxWidth="10rem" />
                                </layoutData>
                            </DatePicker>
                        </VBox>
                        <VBox class="sapUiTinyMarginEnd sapUiTinyMarginBottom">
                            <Label text="{i18n>liabilitiesExternalReferenceLabel}" labelFor="newLiabilityExternalReference" />
                            <Input
                                id="newLiabilityExternalReference"
                                value="{ui>/newLiability/externalReference}"
                                width="100%"
                            >
                                <layoutData>
                                    <FlexItemData minWidth="8rem" maxWidth="12rem" />
                                </layoutData>
                            </Input>
                        </VBox>
                        <Button
                            text="{i18n>liabilitiesAddLabel}"
                            icon="sap-icon://add"
                            type="Emphasized"
                            press="handler.onAddLiability"
                            class="sapUiTinyMarginBottom"
                        />
                    </HBox>
                </VBox>

                <List
                    id="liabilitiesList"
                    items="{Liabilities}"
                    mode="None"
                    growing="true"
                    noDataText="{i18n>liabilitiesNoData}"
                    class="shareList cardManagerList"
                >
                    <CustomListItem class="cardManagerCard sapUiTinyMarginBottom">
                        <Panel accessibleRole="Region" class="sapUiNoContentPadding">
                            <headerToolbar>
                                <Toolbar height="auto" class="sapUiTinyMarginTopBottom">
                                    <f:Avatar
                                        src="sap-icon://loan"
                                        displaySize="XS"
                                        class="sapUiTinyMarginEnd"
                                    />
                                    <Title
                                        text="{Name}"
                                        level="H5"
                                        class="sapUiTinyMarginEnd"
                                    />
                                    <ToolbarSpacer />
                                    <Button
                                        icon="sap-icon://activity-items"
                                        type="Transparent"
                                        tooltip="{i18n>liabilitiesMovementsTooltip}"
                                        press="handler.onViewTransactions"
                                    />
                                    <Button
                                        icon="sap-icon://edit"
                                        type="Transparent"
                                        tooltip="{i18n>liabilitiesEditTooltip}"
                                        visible="{= ${ui>/liabilityEditId} !== ${ID} }"
                                        press="handler.onToggleEdit"
                                    />
                                    <Button
                                        icon="sap-icon://accept"
                                        type="Transparent"
                                        tooltip="{i18n>liabilitiesFinishEditTooltip}"
                                        visible="{= ${ui>/liabilityEditId} === ${ID} }"
                                        press="handler.onToggleEdit"
                                    />
                                    <Button
                                        icon="sap-icon://delete"
                                        type="Transparent"
                                        tooltip="{i18n>liabilitiesRemoveTooltip}"
                                        press="handler.onRemoveLiability"
                                    />
                                </Toolbar>
                            </headerToolbar>
                            <content>
                                <VBox
                                    class="liabilityView"
                                    visible="{= ${ui>/liabilityEditId} !== ${ID} }"
                                >
                                    <HBox wrap="Wrap" alignItems="Center" class="liabilityRow">
                                        <Text text="{Creditor}" class="liabilityCreditor" />
                                        <ObjectStatus
                                            text="{ path: 'Status', formatter: 'formatter.liabilityStatusText' }"
                                            state="{
                                                path: 'Status',
                                                formatter: 'formatter.liabilityStatusState'
                                            }"
                                            class="sapUiTinyMarginBegin"
                                        />
                                        <Text
                                            text="{ path: 'Type', formatter: 'formatter.liabilityTypeText' }"
                                            class="liabilityMuted sapUiTinyMarginBegin"
                                        />
                                    </HBox>
                                    <HBox wrap="Wrap" alignItems="Center" class="liabilityRow">
                                        <VBox class="sapUiTinyMarginEnd">
                                            <Label text="{i18n>liabilitiesCurrentBalanceLabel}" class="liabilityFieldLabel" />
                                            <ObjectNumber
                                                number="{
                                                    parts: [ { path: 'CurrentBalance' }, { path: 'Currency_code' } ],
                                                    formatter: 'formatter.formatCardAmount'
                                                }"
                                                state="{ path: 'HealthScore', formatter: 'formatter.liabilityHealthState' }"
                                                class="liabilityAmount"
                                            />
                                        </VBox>
                                        <VBox class="sapUiTinyMarginEnd">
                                            <Label text="{i18n>liabilitiesRemainingAmountLabel}" class="liabilityFieldLabel" />
                                            <ObjectNumber
                                                number="{
                                                    parts: [ { path: 'RemainingAmount' }, { path: 'Currency_code' } ],
                                                    formatter: 'formatter.formatCardAmount'
                                                }"
                                                class="liabilityAmount"
                                            />
                                        </VBox>
                                        <VBox class="sapUiTinyMarginEnd">
                                            <Label text="{i18n>liabilitiesPaidAmountLabel}" class="liabilityFieldLabel" />
                                            <ObjectNumber
                                                number="{
                                                    parts: [ { path: 'PaidAmount' }, { path: 'Currency_code' } ],
                                                    formatter: 'formatter.formatCardAmount'
                                                }"
                                                class="liabilityAmount"
                                            />
                                        </VBox>
                                        <VBox class="sapUiTinyMarginEnd">
                                            <Label text="{i18n>liabilitiesOriginalAmountLabel}" class="liabilityFieldLabel" />
                                            <ObjectNumber
                                                number="{
                                                    parts: [ { path: 'OriginalAmount' }, { path: 'Currency_code' } ],
                                                    formatter: 'formatter.formatCardAmount'
                                                }"
                                                class="liabilityAmount"
                                            />
                                        </VBox>
                                        <VBox class="sapUiTinyMarginEnd">
                                            <Label text="{i18n>liabilitiesProgressLabel}" class="liabilityFieldLabel" />
                                            <ProgressIndicator
                                                percentValue="{ path: 'ProgressPercent', formatter: 'formatter.liabilityProgressValue' }"
                                                displayValue="{ path: 'ProgressPercent', formatter: 'formatter.liabilityProgressText' }"
                                                state="None"
                                                width="8rem"
                                            />
                                        </VBox>
                                        <VBox class="sapUiTinyMarginEnd">
                                            <Label text="{i18n>liabilitiesPaidInstallmentsLabel}" class="liabilityFieldLabel" />
                                            <Text
                                                text="{
                                                    parts: [ { path: 'PaidInstallments' }, { path: 'Installments' } ],
                                                    formatter: 'formatter.liabilityInstallmentText'
                                                }"
                                            />
                                        </VBox>
                                        <VBox class="sapUiTinyMarginEnd">
                                            <Label text="{i18n>liabilitiesNextDueDateLabel}" class="liabilityFieldLabel" />
                                            <Text
                                                text="{ path: 'NextDueDate', formatter: 'formatter.formatDate' }"
                                            />
                                        </VBox>
                                    </HBox>
                                    <HBox wrap="Wrap" alignItems="Center" class="liabilityRow">
                                        <Text
                                            text="{
                                                parts: [ { path: 'StartDate' }, { path: 'FirstDueDate' } ],
                                                formatter: 'formatter.liabilityDatesText'
                                            }"
                                            class="liabilityMuted"
                                        />
                                        <Text
                                            text="{
                                                parts: [ { path: 'InterestMode' }, { path: 'InterestRate' } ],
                                                formatter: 'formatter.liabilityInterestText'
                                            }"
                                            class="liabilityMuted sapUiTinyMarginBegin"
                                        />
                                        <Text
                                            text="{
                                                parts: [ { path: 'i18n>liabilitiesIsOverdueLabel' }, { path: 'IsOverdue' } ],
                                                formatter: 'formatter.liabilityOverdueText'
                                            }"
                                            class="liabilityMuted sapUiTinyMarginBegin"
                                        />
                                    </HBox>
                                    <Text
                                        text="{Description}"
                                        visible="{= ${Description} !== '' }"
                                        class="liabilityMuted sapUiTinyMarginTop"
                                    />
                                </VBox>

                                <VBox
                                    class="liabilityEdit"
                                    visible="{= ${ui>/liabilityEditId} === ${ID} }"
                                >
                                    <HBox wrap="Wrap" alignItems="End" class="liabilityRow">
                                        <VBox class="sapUiTinyMarginEnd sapUiTinyMarginBottom">
                                            <Label text="{i18n>liabilitiesNameLabel}" />
                                            <Input value="{Name}" width="100%">
                                                <layoutData>
                                                    <FlexItemData minWidth="10rem" maxWidth="14rem" growFactor="1" />
                                                </layoutData>
                                            </Input>
                                        </VBox>
                                        <VBox class="sapUiTinyMarginEnd sapUiTinyMarginBottom">
                                            <Label text="{i18n>liabilitiesCreditorLabel}" />
                                            <Input value="{Creditor}" width="100%">
                                                <layoutData>
                                                    <FlexItemData minWidth="8rem" maxWidth="12rem" growFactor="1" />
                                                </layoutData>
                                            </Input>
                                        </VBox>
                                        <VBox class="sapUiTinyMarginEnd sapUiTinyMarginBottom">
                                            <Label text="{i18n>liabilitiesTypeLabel}" />
                                            <Select
                                                selectedKey="{Type}"
                                                items="{ui>/liabilityTypeOptions}"
                                                width="100%"
                                                forceSelection="false"
                                            >
                                                <core:Item key="{ui>key}" text="{ui>text}" />
                                            </Select>
                                        </VBox>
                                        <VBox class="sapUiTinyMarginEnd sapUiTinyMarginBottom">
                                            <Label text="{i18n>liabilitiesStatusLabel}" />
                                            <Select
                                                selectedKey="{Status}"
                                                items="{ui>/liabilityStatusOptions}"
                                                width="100%"
                                                forceSelection="false"
                                            >
                                                <core:Item key="{ui>key}" text="{ui>text}" />
                                            </Select>
                                        </VBox>
                                        <VBox class="sapUiTinyMarginEnd sapUiTinyMarginBottom">
                                            <Label text="{i18n>liabilitiesOriginalAmountLabel}" />
                                            <Input value="{OriginalAmount}" type="Number" width="100%">
                                                <layoutData>
                                                    <FlexItemData minWidth="6rem" maxWidth="8rem" />
                                                </layoutData>
                                            </Input>
                                        </VBox>
                                        <VBox class="sapUiTinyMarginEnd sapUiTinyMarginBottom">
                                            <Label text="{i18n>liabilitiesCurrencyLabel}" />
                                            <Select selectedKey="{Currency_code}" width="100%">
                                                <layoutData>
                                                    <FlexItemData minWidth="6rem" maxWidth="8rem" />
                                                </layoutData>
                                                <core:Item key="BRL" text="BRL" />
                                                <core:Item key="USD" text="USD" />
                                            </Select>
                                        </VBox>
                                        <VBox class="sapUiTinyMarginEnd sapUiTinyMarginBottom">
                                            <Label text="{i18n>liabilitiesInterestModeLabel}" />
                                            <Select
                                                selectedKey="{InterestMode}"
                                                items="{ui>/liabilityInterestModeOptions}"
                                                width="100%"
                                                forceSelection="false"
                                            >
                                                <core:Item key="{ui>key}" text="{ui>text}" />
                                            </Select>
                                        </VBox>
                                        <VBox class="sapUiTinyMarginEnd sapUiTinyMarginBottom">
                                            <Label text="{i18n>liabilitiesInterestRateLabel}" />
                                            <Input value="{InterestRate}" type="Number" width="100%">
                                                <layoutData>
                                                    <FlexItemData minWidth="5.5rem" maxWidth="7rem" />
                                                </layoutData>
                                            </Input>
                                        </VBox>
                                        <VBox class="sapUiTinyMarginEnd sapUiTinyMarginBottom">
                                            <Label text="{i18n>liabilitiesInstallmentsLabel}" />
                                            <Input value="{Installments}" type="Number" width="100%">
                                                <layoutData>
                                                    <FlexItemData minWidth="5rem" maxWidth="6rem" />
                                                </layoutData>
                                            </Input>
                                        </VBox>
                                        <VBox class="sapUiTinyMarginEnd sapUiTinyMarginBottom">
                                            <Label text="{i18n>liabilitiesStartDateLabel}" />
                                            <DatePicker value="{StartDate}" width="100%">
                                                <layoutData>
                                                    <FlexItemData minWidth="8rem" maxWidth="10rem" />
                                                </layoutData>
                                            </DatePicker>
                                        </VBox>
                                        <VBox class="sapUiTinyMarginEnd sapUiTinyMarginBottom">
                                            <Label text="{i18n>liabilitiesFirstDueDateLabel}" />
                                            <DatePicker value="{FirstDueDate}" width="100%">
                                                <layoutData>
                                                    <FlexItemData minWidth="8rem" maxWidth="10rem" />
                                                </layoutData>
                                            </DatePicker>
                                        </VBox>
                                        <VBox class="sapUiTinyMarginEnd sapUiTinyMarginBottom">
                                            <Label text="{i18n>liabilitiesExternalReferenceLabel}" />
                                            <Input value="{ExternalReference}" width="100%">
                                                <layoutData>
                                                    <FlexItemData minWidth="8rem" maxWidth="12rem" />
                                                </layoutData>
                                            </Input>
                                        </VBox>
                                        <VBox class="sapUiTinyMarginEnd sapUiTinyMarginBottom">
                                            <Label text="{i18n>liabilitiesDescriptionLabel}" />
                                            <Input value="{Description}" width="100%">
                                                <layoutData>
                                                    <FlexItemData minWidth="12rem" growFactor="2" />
                                                </layoutData>
                                            </Input>
                                        </VBox>
                                    </HBox>
                                </VBox>
                            </content>
                        </Panel>
                    </CustomListItem>
                </List>
            </VBox>
        </content>
        <buttons>
            <Button
                text="{i18n>liabilitiesSaveButton}"
                icon="sap-icon://save"
                type="Emphasized"
                press="handler.onSaveLiabilities"
            />
            <Button
                text="{i18n>liabilitiesCancelButton}"
                icon="sap-icon://cancel"
                press="handler.onCancelLiabilities"
            />
            <Button
                text="{i18n>liabilitiesDiscardButton}"
                type="Transparent"
                press="handler.onDiscardLiabilities"
            />
        </buttons>
    </Dialog>
</core:FragmentDefinition>
