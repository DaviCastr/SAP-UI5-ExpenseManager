<mvc:View
    controllerName="apps.dflc.expensemanager.controller.Home"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    core:require="{
        formatter: 'apps/dflc/expensemanager/util/format'
    }"
>
    <Page id="homePage" showHeader="false" enableScrolling="true" class="financePage">
        <content>
            <VBox class="financeShell">
                <HBox class="topBar" justifyContent="SpaceBetween" alignItems="Center" wrap="Wrap">
                    <HBox alignItems="Center" class="brandGroup">
                        <core:Icon src="sap-icon://wallet" class="brandMark" />
                        <VBox>
                            <Title text="{i18n>brandTitle}" level="H2" class="brandTitle" />
                            <Text text="{ui>/monthLabel}" class="brandCaption" />
                        </VBox>
                    </HBox>
                    <HBox alignItems="Center" class="topActions" wrap="Wrap">
                        <Text text="{i18n>personManageLabel}" class="personLabel" />
                        <Avatar
                            src="{ui>/selectedPersonImage}"
                            initials="{ path: 'ui>/selectedPerson/Name', formatter: 'formatter.initials' }"
                            displaySize="XS"
                            displayShape="Circle"
                            class="personAvatar"
                        />
                        <Select
                            id="personSelect"
                            items="{ui>/personOptions}"
                            selectedKey="{ui>/selectedPerson/ID}"
                            change=".onPersonChange"
                            class="personSelect"
                            width="12rem"
                        >
                            <core:Item key="{key}" text="{text}" />
                        </Select>
                        <Button
                            icon="sap-icon://add"
                            type="Transparent"
                            tooltip="{i18n>personAddButton}"
                            press=".onOpenPersonDialog"
                            class="iconAction"
                        />
                        <Button
                            icon="sap-icon://log"
                            type="Transparent"
                            tooltip="{i18n>logoutTooltip}"
                            press=".onLogout"
                            class="iconAction"
                        />
                    </HBox>
                </HBox>

                <HBox class="balanceHero" justifyContent="SpaceBetween" alignItems="Stretch" wrap="Wrap" busy="{ui>/busy}">
                    <VBox class="balanceCopy">
                        <Text text="SEU DINHEIRO, COM CLAREZA" class="eyebrow" />
                        <Title text="Olá, {ui>/selectedPerson/Name}!" level="H1" class="heroTitle" />
                        <Text text="Aqui está o panorama financeiro deste mês." class="heroSubtitle" />
                        <HBox class="heroActions" wrap="Wrap">
                        <Button text="Registrar gasto" icon="sap-icon://add" type="Emphasized" press=".onOpenExpenseDialog" class="primaryAction" />
                        <Button text="Adicionar cartão" icon="sap-icon://credit-card" type="Transparent" press=".onOpenCardDialog" class="secondaryAction" />
                        <Button text="Simular gastos" icon="sap-icon://customer-view" type="Transparent" press=".onOpenSimulationDialog" class="secondaryAction" />
                        <Button text="Restaurar backup" icon="sap-icon://upload-to-cloud" type="Transparent" press=".onRestoreBackup" class="secondaryAction" />
                        <Button text="Exportar backup" icon="sap-icon://download-to-cloud" type="Transparent" press=".onExportBackup" class="secondaryAction" />
                        </HBox>
                    </VBox>
                    <VBox class="balanceCard">
                        <Text text="DISPONÍVEL ESTE MÊS" class="balanceLabel" />
                        <ObjectNumber number="{ui>/summary/available}" class="balanceNumber" />
                        <HBox alignItems="Center" class="balanceTrend">
                            <core:Icon src="{ui>/summary/trendIcon}" />
                            <Text text="{ui>/summary/trendText}" />
                        </HBox>
                    </VBox>
                </HBox>

                <HBox class="periodNav" justifyContent="SpaceBetween" alignItems="Center" wrap="Wrap" visible="{= !${ui>/personsEmpty} }">
                    <VBox>
                        <Title text="Visão geral do período" level="H3" />
                        <Text text="{ui>/monthLabel}" class="sectionHint" />
                    </VBox>
                    <HBox alignItems="Center" class="periodNavActions">
                        <Button icon="sap-icon://slim-arrow-left" type="Transparent" press=".onPreviousMonth" tooltip="{i18n>previousMonthTooltip}" class="iconAction" />
                        <Button text="{ui>/monthLabel}" type="Transparent" press=".onThisMonth" tooltip="{i18n>currentMonthTooltip}" class="periodNavLabel" />
                        <Button icon="sap-icon://slim-arrow-right" type="Transparent" press=".onNextMonth" tooltip="{i18n>nextMonthTooltip}" class="iconAction" />
                    </HBox>
                </HBox>

                <VBox class="emptyState" visible="{ui>/personsEmpty}" alignItems="Center" justifyContent="Center">
                    <core:Icon src="sap-icon://inbox" class="emptyStateIcon" />
                    <Title text="{i18n>emptyPersonsTitle}" level="H2" class="emptyStateTitle" />
                    <Text text="{i18n>emptyPersonsText}" class="emptyStateText" />
                    <HBox wrap="Wrap" alignItems="Center" justifyContent="Center">
                        <Button text="{i18n>personAddButton}" icon="sap-icon://person-add" type="Emphasized" press=".onOpenPersonDialog" class="emptyStateButton" />
                        <Button text="{i18n>backupRestoreButton}" icon="sap-icon://upload-to-cloud" type="Transparent" press=".onRestoreBackup" class="emptyStateButton" />
                    </HBox>
                </VBox>

                <HBox class="metricGrid" wrap="Wrap" visible="{= !${ui>/personsEmpty} }">
                    <VBox class="metricCard incomeMetric">
                        <HBox justifyContent="SpaceBetween" alignItems="Start"><Text text="RECEITAS" class="metricLabel" /><core:Icon src="sap-icon://trend-up" /></HBox>
                        <ObjectNumber number="{ui>/summary/income}" class="metricNumber" />
                        <Text text="Entradas previstas no mês" class="metricHint" />
                    </VBox>
                    <VBox class="metricCard expenseMetric">
                        <HBox justifyContent="SpaceBetween" alignItems="Start"><Text text="GASTOS DO MÊS" class="metricLabel" /><core:Icon src="sap-icon://cart" /></HBox>
                        <ObjectNumber number="{ui>/summary/expenses}" class="metricNumber" />
                        <Text text="{ui>/summary/expenseHint}" class="metricHint" />
                    </VBox>
                    <VBox class="metricCard saveMetric">
                        <HBox justifyContent="SpaceBetween" alignItems="Start"><Text text="RESERVA DO MÊS" class="metricLabel" /><core:Icon src="sap-icon://savings" /></HBox>
                        <ObjectNumber number="{ui>/summary/savings}" class="metricNumber" />
                        <Text text="O que sobra após os gastos do mês" class="metricHint" />
                    </VBox>
                    <VBox class="metricCard targetMetric">
                        <HBox justifyContent="SpaceBetween" alignItems="Start"><Text text="META DE GASTO" class="metricLabel" /><core:Icon src="sap-icon://target" /></HBox>
                        <ObjectNumber number="{ui>/summary/target}" class="metricNumber" />
                        <Text text="{ui>/summary/targetHint}" class="metricHint" />
                    </VBox>
                </HBox>

                <HBox class="dashboardGrid" wrap="Wrap" visible="{= !${ui>/personsEmpty} }">
                    <VBox class="surfaceCard transactionsPanel">
                        <HBox justifyContent="SpaceBetween" alignItems="Center" class="sectionHeader">
                            <VBox><Title text="Movimentações recentes" level="H3" /><Text text="Últimos lançamentos desta pessoa" class="sectionHint" /></VBox>
                            <Button icon="sap-icon://add" type="Transparent" press=".onOpenCategoryDialog" tooltip="{i18n>categoryAddButton}" />
                        </HBox>
                        <List
                            items="{ path: 'ui>/invoice/Transactions' }"
                            showSeparators="None"
                            class="transactionList"
                            noDataText="Ainda não há movimentações para este período."
                        >
                            <CustomListItem>
                                <HBox width="100%" alignItems="Center" justifyContent="SpaceBetween" class="transactionItem">
                                    <HBox alignItems="Center">
                                        <VBox class="transactionIcon"><core:Icon src="sap-icon://receipt" /></VBox>
                                        <VBox>
                                            <Text text="{Description}" class="transactionTitle" />
                                            <Text text="{Category/Name} • { formatter: 'formatter.formatDate', path: 'Date' }" class="transactionDate" />
                                        </VBox>
                                    </HBox>
                                    <ObjectNumber
                                        number="{
                                            parts: [
                                                { path: 'Amount' },
                                                { path: '$ui>/invoice/Currency/code' }
                                            ],
                                            formatter: 'formatter.formatCurrency'
                                        }"
                                        class="transactionAmount"
                                    />
                                </HBox>
                            </CustomListItem>
                        </List>
                    </VBox>

                    <VBox class="surfaceCard categoriesPanel">
                        <HBox justifyContent="SpaceBetween" alignItems="Center" class="sectionHeader">
                            <VBox><Title text="Gastos por categoria" level="H3" /><Text text="Distribuição do período" class="sectionHint" /></VBox>
                            <Button icon="sap-icon://add" type="Transparent" press=".onOpenCategoryDialog" tooltip="{i18n>categoryAddButton}" />
                        </HBox>
                        <List
                            items="{ path: 'ui>/categories' }"
                            showSeparators="None"
                            class="categoryList"
                            noDataText="Nenhuma categoria com gastos neste período."
                        >
                            <CustomListItem press=".onCategoryPress">
                                <HBox width="100%" alignItems="Center" justifyContent="SpaceBetween" class="categoryItem">
                                    <HBox alignItems="Center" class="categoryItemMain">
                                        <Avatar
                                            src="{
                                                parts: [ { path: 'CategoryImagePath' } ],
                                                formatter: 'formatter.imageUrl'
                                            }"
                                            displaySize="Custom"
                                            customDisplaySize="2.75rem"
                                            displayShape="Circle"
                                            initials="{Name}"
                                            class="categoryItemAvatar"
                                        />
                                        <VBox>
                                            <Text text="{Name}" class="transactionTitle" />
                                            <ProgressIndicator
                                                percentValue="{Percent}"
                                                displayValue="{Percent}%"
                                                state="None"
                                                width="12rem"
                                                class="categoryProgress"
                                            />
                                        </VBox>
                                    </HBox>
                                    <ObjectNumber
                                        number="{
                                            parts: [
                                                { path: 'Total' },
                                                { path: 'CurrencyCode' }
                                            ],
                                            formatter: 'formatter.formatCurrency'
                                        }"
                                        class="transactionAmount"
                                    />
                                </HBox>
                            </CustomListItem>
                        </List>
                    </VBox>

                    <VBox class="surfaceCard cardsPanel">
                        <HBox justifyContent="SpaceBetween" alignItems="Center" class="sectionHeader">
                            <VBox><Title text="Seus cartões" level="H3" /><Text text="Limites e datas de vencimento" class="sectionHint" /></VBox>
                            <Button icon="sap-icon://add" type="Transparent" press=".onOpenCardDialog" tooltip="Adicionar cartão" />
                        </HBox>
                        <List
                            items="{
                                path: '/Cards',
                                filters: [
                                    { path: 'Person/ID', operator: 'EQ', value: '{ui>/selectedPerson/ID}' }
                                ]
                            }"
                            showSeparators="None"
                            class="cardList"
                            noDataText="Adicione o primeiro cartão desta pessoa."
                        >
                            <CustomListItem>
                                <VBox class="creditCardItem">
                                    <HBox justifyContent="SpaceBetween" alignItems="Center">
                                        <Text text="{Name}" class="creditCardName" />
                                        <core:Icon src="sap-icon://credit-card" />
                                    </HBox>
                                    <Text text="Limite" class="creditCardLabel" />
                                    <ObjectNumber
                                        number="{
                                            parts: [
                                                { path: 'Limit' },
                                                { path: 'Currency' }
                                            ],
                                            formatter: 'formatter.formatCurrency'
                                        }"
                                        class="creditCardValue"
                                    />
                                    <HBox justifyContent="SpaceBetween"><Text text="Fecha dia {ClosingDay}" class="creditCardFoot" /><Text text="Vence dia {DueDay}" class="creditCardFoot" /></HBox>
                                </VBox>
                            </CustomListItem>
                        </List>
                    </VBox>
                </HBox>
            </VBox>
        </content>
    </Page>
</mvc:View>
