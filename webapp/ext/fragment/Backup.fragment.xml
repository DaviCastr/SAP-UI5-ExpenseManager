<core:FragmentDefinition
    xmlns:core="sap.ui.core"
    xmlns="sap.m"
    xmlns:u="sap.ui.unified"
    id="Backup"
>
    <Dialog
        id="backupDialog"
        title="{i18n>backupDialogTitle}"
        class="financeDialog"
        contentWidth="30rem"
        beforeOpen="handler.onDialogBeforeOpen"
        core:require="{ handler: 'apps/dflc/expensemanager/ext/fragment/Backup' }"
    >
        <content>
            <VBox class="dialogContent">
                <Text text="{i18n>backupDialogIntro}" class="dialogIntro" />
                <Label text="{i18n>backupFileLabel}" labelFor="backupFileUploader" />
                <u:FileUploader
                    id="backupFileUploader"
                    buttonText="{i18n>backupFileButton}"
                    placeholder="{i18n>backupFilePlaceholder}"
                    fileType="zip"
                    change="handler.onModificaArquivo"
                    width="100%"
                />
            </VBox>
        </content>
        <beginButton><Button text="{i18n>backupRestoreButton}" type="Emphasized" press="handler.onImportarBackup" /></beginButton>
        <endButton><Button text="{i18n>backupCancelButton}" press="handler.onCancelarBackup" /></endButton>
    </Dialog>
</core:FragmentDefinition>
