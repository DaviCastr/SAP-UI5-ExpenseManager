<core:FragmentDefinition
    xmlns:core="sap.ui.core"
    xmlns="sap.m"
    xmlns:u="sap.ui.unified"
    id="AdicionarCartao"
>
    <Dialog
        id="cardDialog"
        title="{i18n>cardDialogTitle}"
        class="financeDialog"
        contentWidth="28rem"
        beforeOpen="handler.onDialogBeforeOpen"
        core:require="{ handler: 'apps/dflc/expensemanager/ext/fragment/AddCard' }"
    >
        <content>
            <VBox class="dialogContent">
                <Text text="{i18n>cardDialogIntro}" class="dialogIntro" />
                <Avatar
                    id="cardAvatar"
                    displaySize="Custom"
                    customDisplaySize="5.5rem"
                    displayShape="Circle"
                    initials="C"
                    class="sapUiTinyMarginBottom"
                />
                <u:FileUploader
                    id="cardFileUploader"
                    buttonText="{i18n>cardPhotoButton}"
                    placeholder="{i18n>cardPhotoPlaceholder}"
                    fileType="png,jpg,jpeg"
                    uploadOnChange="false"
                    multiple="false"
                    change="handler.onModificaArquivo"
                    width="100%"
                />
                <Label text="{i18n>cardNameLabel}" labelFor="cardName" />
                <Input id="cardName" value="{ui>/newCard/name}" placeholder="{i18n>cardNamePlaceholder}" />
                <Label text="{i18n>cardLimitLabel}" labelFor="cardLimit" />
                <Input id="cardLimit" value="{ui>/newCard/limit}" type="Number" placeholder="{i18n>cardLimitPlaceholder}" />
                <Label text="{i18n>cardCurrencyLabel}" labelFor="cardCurrency" />
                <Select id="cardCurrency" selectedKey="{ui>/newCard/currency}">
                    <core:Item key="BRL" text="Real brasileiro (BRL)" />
                    <core:Item key="USD" text="Dólar americano (USD)" />
                </Select>
            </VBox>
        </content>
        <beginButton><Button text="{i18n>cardSaveButton}" type="Emphasized" press="handler.onAdicionarCartao" /></beginButton>
        <endButton><Button text="{i18n>cardCancelButton}" press="handler.onCancelarCartao" /></endButton>
    </Dialog>
</core:FragmentDefinition>
