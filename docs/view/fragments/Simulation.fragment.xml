<core:FragmentDefinition
    xmlns:core="sap.ui.core"
    xmlns="sap.m"
    id="Simulation"
>
    <Dialog
        id="simulationDialog"
        title="{i18n>simulationDialogTitle}"
        class="financeDialog"
        contentWidth="32rem"
        core:require="{
            formatter: 'apps/dflc/expensemanager/util/format',
            handler: 'apps/dflc/expensemanager/controller/fragments/Simulation'
        }"
    >
        <content>
            <VBox class="dialogContent">
                <Text text="{i18n>simulationDialogIntro}" class="dialogIntro" />

                <HBox class="simulationInputs" wrap="Wrap">
                    <VBox class="simulationField">
                        <Label text="{i18n>simulationMonthLabel}" labelFor="simulationMonth" />
                        <Select
                            id="simulationMonth"
                            selectedKey="{ui>/simulation/month}"
                            items="{ path: 'ui>/simulationMonthOptions' }"
                        >
                            <core:Item key="{ui>key}" text="{ui>text}" />
                        </Select>
                    </VBox>
                    <VBox class="simulationField">
                        <Label text="{i18n>simulationYearLabel}" labelFor="simulationYear" />
                        <Input id="simulationYear" value="{ui>/simulation/year}" type="Number" />
                    </VBox>
                </HBox>

                    <VBox visible="{= ${ui>/simulationResult} !== null }" class="simulationResult">
                        <HBox class="simulationMetricRow" justifyContent="SpaceBetween" alignItems="Center">
                            <Text text="Gastos projetados no mês" class="simulationMetricLabel" />
                            <ObjectNumber
                                number="{
                                    parts: [ { path: 'ui>/simulationResult/TotalMonth' }, { path: 'ui>/simulationResult/Currency/code' } ],
                                    formatter: 'formatter.formatCurrency'
                                }"
                                class="simulationMetricValue"
                            />
                        </HBox>
                        <HBox class="simulationMetricRow" justifyContent="SpaceBetween" alignItems="Center">
                            <Text text="Reserva estimada no fim do mês" class="simulationMetricLabel" />
                            <ObjectNumber
                                number="{
                                    parts: [ { path: 'ui>/simulationResult/AmountSaving' }, { path: 'ui>/simulationResult/Currency/code' } ],
                                    formatter: 'formatter.formatCurrency'
                                }"
                                class="simulationMetricValue"
                            />
                        </HBox>
                        <HBox class="simulationMetricRow" justifyContent="SpaceBetween" alignItems="Center">
                            <Text text="Gastos futuros já comprometidos" class="simulationMetricLabel" />
                            <ObjectNumber
                                number="{
                                    parts: [ { path: 'ui>/simulationResult/TotalAmount' }, { path: 'ui>/simulationResult/Currency/code' } ],
                                    formatter: 'formatter.formatCurrency'
                                }"
                                class="simulationMetricValue"
                            />
                        </HBox>
                    </VBox>
            </VBox>
        </content>
        <beginButton><Button text="{i18n>simulationRunButton}" type="Emphasized" press="handler.onSimularGastos" /></beginButton>
        <endButton><Button text="{i18n>simulationCancelButton}" press="handler.onCancelarSimulacao" /></endButton>
    </Dialog>
</core:FragmentDefinition>
