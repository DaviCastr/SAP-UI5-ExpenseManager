<mvc:View
    controllerName="apps.dflc.expensemanager.controller.Home"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
>
    <Page id="homePage" title="{i18n>homeTitle}" showHeader="false">
        <content>
            <VBox class="dashboardShell">
                <HBox class="heroCard" justifyContent="SpaceBetween" alignItems="Center">
                    <VBox class="heroCopy">
                        <Text text="{i18n>heroEyebrow}" class="eyebrow" />
                        <Title text="{i18n>heroTitle}" level="H1" />
                        <Text text="{i18n>heroSubtitle}" class="heroSubtitle" />
                        <Button text="{i18n>heroButton}" press=".onOpenInsights" type="Emphasized" class="heroButton" />
                    </VBox>
                    <VBox class="heroSummary">
                        <Text text="{i18n>heroBalanceLabel}" class="summaryLabel" />
                        <Title text="{i18n>heroBalanceValue}" level="H2" />
                        <Text text="{i18n>heroBalanceHint}" class="summaryHint" />
                    </VBox>
                </HBox>

                <HBox class="statsGrid" wrap="Wrap">
                    <VBox class="statCard">
                        <Text text="{i18n>statIncome}" class="statLabel" />
                        <Title text="R$ 8.400" level="H3" />
                    </VBox>
                    <VBox class="statCard">
                        <Text text="{i18n>statExpenses}" class="statLabel" />
                        <Title text="R$ 2.980" level="H3" />
                    </VBox>
                    <VBox class="statCard">
                        <Text text="{i18n>statSavings}" class="statLabel" />
                        <Title text="R$ 5.420" level="H3" />
                    </VBox>
                    <VBox class="statCard">
                        <Text text="{i18n>statCards}" class="statLabel" />
                        <Title text="3 ativos" level="H3" />
                    </VBox>
                </HBox>

                <HBox class="contentGrid" wrap="Wrap">
                    <VBox class="panelCard panelWide">
                        <HBox justifyContent="SpaceBetween" alignItems="Center">
                            <Title text="{i18n>sectionCards}" level="H3" />
                            <Button text="{i18n>sectionCardsAction}" type="Transparent" />
                        </HBox>
                        <List items="{/Cards}" class="dashboardList">
                            <StandardListItem
                                title="{Name}"
                                description="{i18n>creditCardDescription}"
                                info="R$ {Limit}"
                                infoState="Success"
                            />
                        </List>
                    </VBox>

                    <VBox class="panelCard">
                        <Title text="{i18n>sectionPerson}" level="H3" />
                        <List items="{/Persons}" class="dashboardList">
                            <StandardListItem title="{Name}" description="{Email}" />
                        </List>
                    </VBox>
                </HBox>
            </VBox>
        </content>
    </Page>
</mvc:View>
